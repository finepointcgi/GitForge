<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <Company>GitForge Contributors</Company>
    <Product>GitForge</Product>
    <!-- Release builds take the version from the git tag (vX.Y.Z); see .github/workflows/release.yml. -->
    <Version>0.1.0</Version>
    <RepositoryUrl>https://github.com/finepointcgi/GitForge</RepositoryUrl>
    <!-- No telemetry. The only request GitForge makes on its own is the daily update check, which sends no
         identifiers and can be turned off in Settings or by policy: safe for disconnected / CUI environments. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
</Project>
