<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Versioned Windows TFM is required: the WebView2 SDK's WPF assembly for .NET 5+ references the
         Windows 10 SDK projection (Microsoft.Windows.SDK.NET), which ships only with a versioned TFM.
         10.0.17763.0 = Windows 10 version 1809, the minimum supported OS. -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>GitForge.Desktop</RootNamespace>
    <AssemblyName>GitForge</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Explorer, taskbar, and Alt+Tab icon. Regenerate from assets/brand/gitforge-logo.png (16-256 px). -->
    <ApplicationIcon>Assets\GitForge.ico</ApplicationIcon>
    <!-- Program.Main runs Velopack's install/update hooks before WPF starts. -->
    <StartupObject>GitForge.Desktop.Program</StartupObject>
    <!-- Where installed copies look for updates: a GitHub repository, an https feed, or a folder / UNC share.
         Build with -p:GitForgeUpdateFeed=... to ship a copy that updates from an internal mirror. -->
    <GitForgeUpdateFeed Condition="'$(GitForgeUpdateFeed)' == ''">$(RepositoryUrl)</GitForgeUpdateFeed>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="GitForgeUpdateFeed" Value="$(GitForgeUpdateFeed)" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\GitForge.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GitForge.UI\GitForge.UI.csproj" />
  </ItemGroup>
</Project>
