@* One commit row of the graph. Geometry comes from GitForge.Core so every renderer draws identically. *@
@{
    var g = Geometry;
    var cx = g.X(Row.NodeLane);
    var cy = g.RowHeight / 2;
    var color = Avatars.LaneColor(Row.NodeColorIndex);
}
@* With labels right of the graph, the SVG spans the column so the connector can reach its right edge. *@
<svg class="gf-graph" width="@(HasRefs && RefsOnRight ? "100%" : F(g.Width(Math.Max(Row.LaneCount, WipLane + 1))))" height="@F(g.RowHeight)" aria-hidden="true">
    @if (HasRefs && RefsOnRight)
    {
        <line class="gf-ref-connector" x1="@F(cx + g.NodeRadius)" y1="@F(cy)" x2="100%" y2="@F(cy)" stroke="@color" />
    }
    else if (HasRefs && cx > g.NodeRadius)
    {
        <line class="gf-ref-connector" x1="0" y1="@F(cy)" x2="@F(cx - g.NodeRadius)" y2="@F(cy)" stroke="@color" />
    }
    @if (WipLane >= 0)
    {
        @* Rows above HEAD carry the connector straight down; the HEAD row bends it into the node. *@
        <path class="gf-wip-link" fill="none" stroke="@(WipColor ?? color)"
              d="@(IsHead ? g.PathFor(new GraphEdge(EdgeKind.IntoNode, WipLane, Row.NodeLane, 0), Row.NodeLane) : g.PathFor(new GraphEdge(EdgeKind.PassThrough, WipLane, WipLane, 0), Row.NodeLane))" />
    }
    @foreach (var e in Row.Edges)
    {
        <path d="@g.PathFor(e, Row.NodeLane)" stroke="@Avatars.LaneColor(e.ColorIndex)" />
    }
    @if (Row.Commit.IsMerge)
    {
        <circle cx="@F(cx)" cy="@F(cy)" r="5" fill="@color" class="gf-merge-dot" />
    }
    else
    {
        @if (IsHead)
        {
            <circle cx="@F(cx)" cy="@F(cy)" r="@F(g.NodeRadius + 3)" fill="none" stroke="@color" class="gf-head-ring" />
        }
        <circle cx="@F(cx)" cy="@F(cy)" r="@F(g.NodeRadius)" fill="@color" class="gf-avatar-node" />
        @* Razor reserves <text>; emit the SVG text element as encoded markup. *@
        @((MarkupString)$"<text x=\"{F(cx)}\" y=\"{F(cy)}\" class=\"gf-avatar-text\">{System.Net.WebUtility.HtmlEncode(Avatars.Initials(Row.Commit.AuthorName))}</text>")
    }
</svg>

@code {
    public static readonly GraphGeometry Geometry = new(LaneWidth: 22, RowHeight: 32, NodeRadius: 10);

    [Parameter, EditorRequired] public GraphRow Row { get; set; } = default!;
    [Parameter] public bool IsHead { get; set; }
    [Parameter] public bool HasRefs { get; set; }

    /// <summary>Branch / Tag labels sit right of the graph, so the connector runs from the node to the right.</summary>
    [Parameter] public bool RefsOnRight { get; set; }

    /// <summary>Lane of the dashed WIP → HEAD connector crossing this row (HEAD itself or a row above it); -1 for none.</summary>
    [Parameter] public int WipLane { get; set; } = -1;

    /// <summary>Connector color (HEAD's lane color); defaults to this row's color.</summary>
    [Parameter] public string? WipColor { get; set; }

    private static string F(double v) => v.ToString("0.#", CultureInfo.InvariantCulture);
}
