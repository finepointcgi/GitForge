@implements IDisposable
@inject RepoWorkspace W
@inject IDialogService Dialogs
@inject IAccountService Accounts
@inject IPlatformShell Shell

<div class="gf-sidebar-inner">
    <div class="gf-side-section">
        <div class="gf-side-title">Workspace</div>
        <div class="gf-side-item @(W.View == WorkspaceView.FileStatus ? "selected" : null)" @onclick="@(() => W.SetView(WorkspaceView.FileStatus))">
            <MudIcon Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" /> File status
            @if (W.Status.TotalCount > 0)
            {
                <span class="gf-count">@W.Status.TotalCount</span>
            }
        </div>
        <div class="gf-side-item @(W.View == WorkspaceView.History ? "selected" : null)" @onclick="@(() => W.SetView(WorkspaceView.History))">
            <MudIcon Icon="@Icons.Material.Outlined.AccountTree" Size="Size.Small" /> History
        </div>
        <div class="gf-side-item @(W.View == WorkspaceView.Reflog ? "selected" : null)" @onclick="@(() => W.SetView(WorkspaceView.Reflog))">
            <MudIcon Icon="@Icons.Material.Outlined.Restore" Size="Size.Small" /> Reflog
        </div>
    </div>

    @if (W.Snapshot is { } s)
    {
        <div class="gf-side-filter">
            <input class="gf-input" placeholder="Filter branches, tags…" @bind="_filter" @bind:event="oninput" aria-label="Filter sidebar" />
        </div>

        <SideSection Title="Branches" Count="s.LocalBranches.Count" @bind-Expanded="_branchesOpen">
            @foreach (var b in Filter(s.LocalBranches, b => b.Name))
            {
                <MudMenu ActivationEvent="@MouseEvent.RightClick" PositionAtCursor="true" Dense="true" FullWidth="true">
                    <ActivatorContent Context="menu">
                        <div @oncontextmenu="@(e => menu.OpenAsync(e))" class="gf-side-item @(b.IsCurrent ? "current" : null)" title="@b.CanonicalName" @ondblclick="@(() => Checkout(b))">
                            <MudIcon Icon="@(b.IsCurrent ? Icons.Material.Filled.RadioButtonChecked : Icons.Material.Outlined.CallSplit)" Size="Size.Small" />
                            <span class="gf-ellipsis">@b.Name</span>
                            @if (b.Ahead > 0) { <span class="gf-pill ahead" title="Commits to push">↑@b.Ahead</span> }
                            @if (b.Behind > 0) { <span class="gf-pill behind" title="Commits to pull">↓@b.Behind</span> }
                            @if (b.UpstreamName is not null && b.Ahead is null) { <span class="gf-pill gone" title="Upstream branch is gone">gone</span> }
                        </div>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem Disabled="@b.IsCurrent" OnClick="@(() => Checkout(b))">Checkout</MudMenuItem>
                        <MudMenuItem Disabled="@b.IsCurrent" OnClick="@(() => Merge(b.Name))">Merge into current branch</MudMenuItem>
                        <MudMenuItem Disabled="@b.IsCurrent" OnClick="@(() => Rebase(b.Name))">Rebase current branch onto @b.Name</MudMenuItem>
                        <MudDivider />
                        <MudMenuItem OnClick="@(() => Push(b))">Push to @(b.RemoteName ?? W.DefaultRemote?.Name ?? "remote")</MudMenuItem>
                        <MudMenuItem OnClick="@(() => CreatePr(b))">Create pull request…</MudMenuItem>
                        <MudDivider />
                        <MudMenuItem OnClick="@(() => Rename(b))">Rename…</MudMenuItem>
                        <MudMenuItem Disabled="@b.IsCurrent" OnClick="@(() => Delete(b))"><span class="gf-danger">Delete…</span></MudMenuItem>
                    </ChildContent>
                </MudMenu>
            }
        </SideSection>

        <SideSection Title="Remotes" Count="s.RemoteBranches.Count" @bind-Expanded="_remotesOpen">
            @foreach (var remote in s.Remotes)
            {
                <div class="gf-side-subtitle" title="@remote.FetchUrl">
                    <MudIcon Icon="@ProviderIcon(remote.Hosted?.Provider)" Size="Size.Small" /> @remote.Name
                </div>
                @foreach (var b in Filter(s.RemoteBranches.Where(r => r.RemoteName == remote.Name), b => b.Name))
                {
                    <MudMenu ActivationEvent="@MouseEvent.RightClick" PositionAtCursor="true" Dense="true" FullWidth="true">
                        <ActivatorContent Context="menu">
                            <div @oncontextmenu="@(e => menu.OpenAsync(e))" class="gf-side-item gf-indent" title="@b.CanonicalName" @ondblclick="@(() => CheckoutRemote(b))">
                                <MudIcon Icon="@Icons.Material.Outlined.CloudQueue" Size="Size.Small" />
                                <span class="gf-ellipsis">@b.Name[(remote.Name.Length + 1)..]</span>
                            </div>
                        </ActivatorContent>
                        <ChildContent>
                            <MudMenuItem OnClick="@(() => CheckoutRemote(b))">Checkout as local branch</MudMenuItem>
                            <MudMenuItem OnClick="@(() => Merge(b.Name))">Merge into current branch</MudMenuItem>
                            <MudMenuItem OnClick="@(() => Rebase(b.Name))">Rebase current branch onto this</MudMenuItem>
                            <MudDivider />
                            <MudMenuItem OnClick="@(() => DeleteRemote(b))"><span class="gf-danger">Delete on @remote.Name…</span></MudMenuItem>
                        </ChildContent>
                    </MudMenu>
                }
            }
        </SideSection>

        <SideSection Title="Tags" Count="s.Tags.Count" @bind-Expanded="_tagsOpen">
            @foreach (var t in Filter(s.Tags, t => t.Name).Take(300))
            {
                <MudMenu ActivationEvent="@MouseEvent.RightClick" PositionAtCursor="true" Dense="true" FullWidth="true">
                    <ActivatorContent Context="menu">
                        <div @oncontextmenu="@(e => menu.OpenAsync(e))" class="gf-side-item" title="@(t.Message ?? t.TargetSha)">
                            <MudIcon Icon="@Icons.Material.Outlined.LocalOffer" Size="Size.Small" />
                            <span class="gf-ellipsis">@t.Name</span>
                        </div>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem OnClick="@(() => Run($"Checking out {t.Name}", r => r.Branches.CheckoutAsync(t.Name)))">Checkout (detached)</MudMenuItem>
                        <MudMenuItem OnClick="@(() => PushTag(t))">Push tag</MudMenuItem>
                        <MudMenuItem OnClick="@(() => DeleteTag(t))"><span class="gf-danger">Delete…</span></MudMenuItem>
                    </ChildContent>
                </MudMenu>
            }
        </SideSection>

        <SideSection Title="Stashes" Count="s.Stashes.Count" @bind-Expanded="_stashesOpen">
            @foreach (var st in s.Stashes)
            {
                <MudMenu ActivationEvent="@MouseEvent.RightClick" PositionAtCursor="true" Dense="true" FullWidth="true">
                    <ActivatorContent Context="menu">
                        <div @oncontextmenu="@(e => menu.OpenAsync(e))" class="gf-side-item" title="@($"{st.RefSpec} · {st.When.LocalDateTime:g}")" @ondblclick="@(() => ApplyStash(st, false))">
                            <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Size="Size.Small" />
                            <span class="gf-ellipsis">@st.Message</span>
                        </div>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem OnClick="@(() => ApplyStash(st, false))">Apply</MudMenuItem>
                        <MudMenuItem OnClick="@(() => ApplyStash(st, true))">Pop (apply and drop)</MudMenuItem>
                        <MudMenuItem OnClick="@(() => DropStash(st))"><span class="gf-danger">Drop…</span></MudMenuItem>
                    </ChildContent>
                </MudMenu>
            }
        </SideSection>

        @if (s.Submodules.Count > 0)
        {
            <SideSection Title="Submodules" Count="s.Submodules.Count" @bind-Expanded="_submodulesOpen">
                <div class="gf-side-actions">
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => Run("Updating submodules", r => r.Submodules.UpdateAsync(true, true, null)))">Update all (recursive)</MudButton>
                </div>
                @foreach (var sm in s.Submodules)
                {
                    <div class="gf-side-item" title="@($"{sm.Path} · {sm.Url}")" @ondblclick="@(() => W.OpenAsync(Path.Combine(s.WorkingDirectory, sm.Path)))">
                        <MudIcon Icon="@Icons.Material.Outlined.Extension" Size="Size.Small" />
                        <span class="gf-ellipsis">@sm.Name</span>
                        @if (sm.State.HasFlag(SubmoduleState.NotInitialized)) { <span class="gf-pill gone">uninit</span> }
                        else if (sm.State.HasFlag(SubmoduleState.OutOfSync)) { <span class="gf-pill behind">out of sync</span> }
                        else if (sm.State.HasFlag(SubmoduleState.WorkDirDirty)) { <span class="gf-pill ahead">dirty</span> }
                    </div>
                }
            </SideSection>
        }
    }
</div>

@code {
    private string _filter = string.Empty;
    private bool _branchesOpen = true, _remotesOpen = true, _tagsOpen, _stashesOpen = true, _submodulesOpen = true;

    protected override void OnInitialized() => W.Changed += OnChanged;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private IEnumerable<T> Filter<T>(IEnumerable<T> items, Func<T, string> name) =>
        string.IsNullOrWhiteSpace(_filter) ? items : items.Where(i => name(i).Contains(_filter, StringComparison.OrdinalIgnoreCase));

    private static string ProviderIcon(HostingProviderKind? kind) => kind switch
    {
        HostingProviderKind.GitHub => Icons.Custom.Brands.GitHub,
        _ => Icons.Material.Outlined.Cloud,
    };

    private Task Run(string label, Func<IGitRepository, Task> op, string? success = null) => W.RunAsync(label, (r, _) => op(r), success);

    private Task Checkout(BranchHead b) => b.IsCurrent ? Task.CompletedTask : Run($"Checking out {b.Name}", r => r.Branches.CheckoutAsync(b.Name));

    private Task CheckoutRemote(BranchHead b)
    {
        var local = b.Name[(b.RemoteName!.Length + 1)..];
        var existing = W.Snapshot?.LocalBranches.FirstOrDefault(l => l.Name == local);
        return existing is not null
            ? Checkout(existing)
            : Run($"Checking out {local}", r => r.Branches.CheckoutRemoteBranchAsync(b.Name, local), $"Created {local} tracking {b.Name}");
    }

    private async Task Merge(string branch)
    {
        if (await Confirm("Merge", $"Merge {branch} into {W.CurrentBranch}?", "Merge")) await Run($"Merging {branch}", r => r.History.MergeAsync(branch, false));
    }

    private async Task Rebase(string onto)
    {
        if (await Confirm("Rebase", $"Rebase {W.CurrentBranch} onto {onto}? Local commits will be rewritten.", "Rebase")) await Run($"Rebasing onto {onto}", r => r.History.RebaseOntoAsync(onto));
    }

    private Task Push(BranchHead b)
    {
        var remote = b.RemoteName ?? W.DefaultRemote?.Name;
        if (remote is null) { W.Info("No remote configured.", Severity.Warning); return Task.CompletedTask; }
        return W.RunAsync($"Pushing {b.Name}", (r, p) => r.Remotes.PushAsync(new PushRequest(remote, b.Name, SetUpstream: !b.HasUpstream), p), $"Pushed {b.Name}");
    }

    private void CreatePr(BranchHead b)
    {
        var remote = W.Snapshot?.Remotes.FirstOrDefault(r => r.Name == (b.RemoteName ?? W.DefaultRemote?.Name));
        if (remote?.Hosted is not { } hosted) { W.Info("The remote is not a recognized hosting provider. Add an account for self-hosted servers.", Severity.Warning); return; }
        var account = Accounts.FindAccountFor(hosted);
        var target = W.Snapshot?.LocalBranches.Any(l => l.Name == "main") == true ? "main" : "master";
        Shell.OpenUrl(Accounts.GetProvider(hosted.Provider).GetCreatePullRequestUrl(account, hosted, b.Name, target));
    }

    private async Task Rename(BranchHead b)
    {
        var name = await TextPromptDialog.ShowAsync(Dialogs, "Rename branch", "New name", b.Name, validateRef: true);
        if (name is not null && name != b.Name) await Run("Renaming branch", r => r.Branches.RenameAsync(b.Name, name));
    }

    private async Task Delete(BranchHead b)
    {
        var result = await Dialogs.ShowMessageBoxAsync("Delete branch", $"Delete local branch '{b.Name}'? Unmerged commits remain recoverable from the reflog for a limited time.", yesText: "Delete", noText: "Force delete", cancelText: "Cancel");
        if (result is null) return;
        await Run($"Deleting {b.Name}", r => r.Branches.DeleteAsync(b.Name, force: result == false));
    }

    private async Task DeleteRemote(BranchHead b)
    {
        var branch = b.Name[(b.RemoteName!.Length + 1)..];
        if (await Confirm("Delete remote branch", $"Delete '{branch}' on {b.RemoteName}? This affects everyone using the remote.", "Delete"))
        {
            await W.RunAsync($"Deleting {b.Name}", (r, p) => r.Branches.DeleteRemoteAsync(b.RemoteName!, branch, p));
        }
    }

    private Task PushTag(TagInfo t)
    {
        var remote = W.DefaultRemote?.Name;
        return remote is null ? Task.CompletedTask : W.RunAsync($"Pushing tag {t.Name}", (r, p) => r.RunRawAsync(["push", "--progress", remote, $"refs/tags/{t.Name}"], p));
    }

    private async Task DeleteTag(TagInfo t)
    {
        if (await Confirm("Delete tag", $"Delete local tag '{t.Name}'?", "Delete")) await Run($"Deleting tag {t.Name}", r => r.Branches.DeleteTagAsync(t.Name));
    }

    private Task ApplyStash(StashInfo st, bool pop) => Run(pop ? "Popping stash" : "Applying stash", r => r.Stashes.ApplyAsync(st.Index, pop, restoreIndex: false));

    private async Task DropStash(StashInfo st)
    {
        if (await Confirm("Drop stash", $"Drop '{st.Message}'? The stash cannot be recovered from the UI afterwards.", "Drop")) await Run("Dropping stash", r => r.Stashes.DropAsync(st.Index));
    }

    private async Task<bool> Confirm(string title, string message, string yes) =>
        await Dialogs.ShowMessageBoxAsync(title, message, yesText: yes, cancelText: "Cancel") == true;

    public void Dispose() => W.Changed -= OnChanged;
}
