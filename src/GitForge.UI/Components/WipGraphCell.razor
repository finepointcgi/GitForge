@* The WIP row, always at the top of the graph: a dashed node with a dashed link down toward HEAD. *@
@{
    var g = GraphCell.Geometry;
    var cx = g.X(Lane);
    var cy = g.RowHeight / 2;
}
<svg class="gf-graph" width="@F(g.Width(Lane + 1))" height="@F(g.RowHeight)" aria-hidden="true">
    @if (LinkDown)
    {
        <line class="gf-wip-link" x1="@F(cx)" y1="@F(cy + g.NodeRadius)" x2="@F(cx)" y2="@F(g.RowHeight)" stroke="@Color" />
    }
    <circle cx="@F(cx)" cy="@F(cy)" r="@F(g.NodeRadius)" class="gf-wip-node" stroke="@Color" />
</svg>

@code {
    [Parameter] public int Lane { get; set; }
    [Parameter] public string Color { get; set; } = "var(--gf-dim)";

    /// <summary>HEAD is in the graph: draw the start of the dashed connector.</summary>
    [Parameter] public bool LinkDown { get; set; }

    private static string F(double v) => v.ToString("0.#", CultureInfo.InvariantCulture);
}
