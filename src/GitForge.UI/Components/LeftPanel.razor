@using GitForge.Git.Undo
@implements IDisposable
@inject RepoWorkspace W
@inject IDialogService Dialogs
@inject IAccountService Accounts
@inject IPlatformShell Shell

<div class="gf-left-inner @(W.DraggedBranch is not null ? "gf-dragging-ref" : null)">
    @if (W.Snapshot is { } s)
    {
        <div class="gf-left-filter">
            <MudIcon Icon="@Icons.Material.Outlined.FilterList" Size="Size.Small" Class="gf-dim" />
            <input class="gf-input gf-input-ghost" placeholder="Filter" @bind="_filter" @bind:event="oninput" aria-label="Filter branches and tags" />
        </div>

        <SideSection Title="Local" Count="s.LocalBranches.Count" @bind-Expanded="_localOpen">
            @if (GoneBranches(s) is { Count: > 0 } gone)
            {
                <button class="gf-gone-note" title="These branches' copies on the remote were deleted (usually after their pull requests merged). Click to review and delete the merged ones." @onclick="@(() => CleanUpGone(gone))">
                    <MudIcon Icon="@Icons.Material.Outlined.CleaningServices" Size="Size.Small" />
                    <span class="gf-ellipsis">Clean up @gone.Count branch@(gone.Count == 1 ? string.Empty : "es") deleted on the remote…</span>
                </button>
            }
            @foreach (var group in Group(Filter(s.LocalBranches, b => b.Name)))
            {
                @if (group.Key is { } folder)
                {
                    <button class="gf-folder" @onclick="@(() => ToggleFolder("l:" + folder))">
                        <MudIcon Icon="@(IsFolderOpen("l:" + folder) ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)" Size="Size.Small" />
                        <MudIcon Icon="@Icons.Material.Outlined.Folder" Size="Size.Small" /> @folder
                        <span class="gf-count">@group.Count()</span>
                    </button>
                }
                @if (group.Key is null || IsFolderOpen("l:" + group.Key))
                {
                    @foreach (var b in group)
                    {
                        var hidden = W.HiddenRefs.Contains(b.CanonicalName);
                        <MudMenu ActivationEvent="@MouseEvent.RightClick" PositionAtCursor="true" Dense="true" FullWidth="true">
                            <ActivatorContent Context="menu">
                                <div class="gf-ref-row @(b.IsCurrent ? "current" : null) @(hidden ? "hidden-ref" : null) @(group.Key is null ? null : "nested") @(W.SoloRef == b.CanonicalName ? "solo" : null) @(_dropOn == b.CanonicalName ? "drop-target" : null)"
                                     title="@((b.UpstreamName is null ? b.CanonicalName : $"{b.CanonicalName} → {b.UpstreamName}{(b.IsUpstreamGone ? " (deleted on the remote)" : null)}") + "\nDrag onto another branch to merge or rebase")"
                                     draggable="true" @ondragstart="@(() => W.BeginBranchDrag(b))" @ondragend="W.EndBranchDrag"
                                     @ondragenter="@(() => DragEnter(b))" @ondragleave="@(() => DragLeave(b))"
                                     @ondragover:preventDefault="true" @ondrop:preventDefault="true" @ondrop="@(() => Drop(b))"
                                     @oncontextmenu="@(e => menu.OpenAsync(e))" @onclick="@(() => Reveal(b.TipSha))" @ondblclick="@(() => Checkout(b))">
                                    <MudIcon Icon="@(b.IsCurrent ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.Computer)" Size="Size.Small" Class="@(b.IsCurrent ? "gf-current-icon" : "gf-dim")" />
                                    <span class="gf-ellipsis gf-grow">@(group.Key is null ? b.Name : b.Name[(group.Key.Length + 1)..])</span>
                                    @if (b.Ahead > 0) { <span class="gf-pill ahead" title="Commits to push">↑@b.Ahead</span> }
                                    @if (b.Behind > 0) { <span class="gf-pill behind" title="Commits to pull">↓@b.Behind</span> }
                                    @if (b.IsUpstreamGone) { <span class="gf-pill remote-gone" title="@GoneTip(b)">remote deleted</span> }
                                    <button class="gf-eye" title="@(hidden ? "Show in graph" : "Hide from graph")" aria-label="@(hidden ? "Show branch" : "Hide branch")"
                                            @onclick:stopPropagation="true" @onclick="@(() => W.ToggleHiddenAsync(b.CanonicalName))">
                                        <MudIcon Icon="@(hidden ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)" Size="Size.Small" />
                                    </button>
                                </div>
                            </ActivatorContent>
                            <ChildContent>
                                <MudMenuItem Disabled="@b.IsCurrent" OnClick="@(() => Checkout(b))">Checkout @b.Name</MudMenuItem>
                                <MudMenuItem Disabled="@b.IsCurrent" OnClick="@(() => Merge(b.Name))">Merge @b.Name into @W.CurrentBranch</MudMenuItem>
                                <MudMenuItem Disabled="@b.IsCurrent" OnClick="@(() => Rebase(b.Name))">Rebase @W.CurrentBranch onto @b.Name</MudMenuItem>
                                <MudDivider />
                                @if (b.IsUpstreamGone)
                                {
                                    <MudMenuItem Disabled="true"><span class="gf-dim gf-small">@b.UpstreamName was deleted on the remote. Local commits are safe.</span></MudMenuItem>
                                    <MudMenuItem OnClick="@(() => Push(b))">Push again to recreate @b.UpstreamName</MudMenuItem>
                                    <MudMenuItem OnClick="@(() => StopTracking(b))">Stop tracking @b.UpstreamName</MudMenuItem>
                                }
                                else
                                {
                                    <MudMenuItem OnClick="@(() => Push(b))">Push to @(b.RemoteName ?? W.DefaultRemote?.Name ?? "remote")</MudMenuItem>
                                    <MudMenuItem OnClick="@(() => CreatePr(b))">Create pull request…</MudMenuItem>
                                }
                                <MudMenuItem OnClick="@(() => W.ShowBranchChanges(b.Name))">Show changes on @b.Name</MudMenuItem>
                                <MudDivider />
                                <MudMenuItem OnClick="@(() => W.SoloAsync(b.CanonicalName))">@(W.SoloRef == b.CanonicalName ? "Unsolo" : "Solo in graph")</MudMenuItem>
                                <MudMenuItem OnClick="@(() => W.ToggleHiddenAsync(b.CanonicalName))">@(hidden ? "Show in graph" : "Hide from graph")</MudMenuItem>
                                <MudDivider />
                                <MudMenuItem OnClick="@(() => Rename(b))">Rename…</MudMenuItem>
                                <MudMenuItem Disabled="@b.IsCurrent" OnClick="@(() => Delete(b))"><span class="gf-danger">Delete @b.Name…</span></MudMenuItem>
                            </ChildContent>
                        </MudMenu>
                    }
                }
            }
        </SideSection>

        <SideSection Title="Remote" Count="s.RemoteBranches.Count" @bind-Expanded="_remoteOpen">
            @foreach (var remote in s.Remotes)
            {
                <button class="gf-folder" title="@remote.FetchUrl" @onclick="@(() => ToggleFolder("r:" + remote.Name))">
                    <MudIcon Icon="@(IsFolderOpen("r:" + remote.Name) ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)" Size="Size.Small" />
                    <MudIcon Icon="@ProviderIcon(remote.Hosted?.Provider)" Size="Size.Small" /> @remote.Name
                    <span class="gf-count">@s.RemoteBranches.Count(r => r.RemoteName == remote.Name)</span>
                </button>
                @if (IsFolderOpen("r:" + remote.Name))
                {
                    @foreach (var b in Filter(s.RemoteBranches.Where(r => r.RemoteName == remote.Name), b => b.Name))
                    {
                        var hidden = W.HiddenRefs.Contains(b.CanonicalName);
                        <MudMenu ActivationEvent="@MouseEvent.RightClick" PositionAtCursor="true" Dense="true" FullWidth="true">
                            <ActivatorContent Context="menu">
                                <div class="gf-ref-row nested @(hidden ? "hidden-ref" : null) @(W.SoloRef == b.CanonicalName ? "solo" : null)" title="@(b.CanonicalName + "\nDrag onto a local branch to merge")"
                                     draggable="true" @ondragstart="@(() => W.BeginBranchDrag(b))" @ondragend="W.EndBranchDrag"
                                     @oncontextmenu="@(e => menu.OpenAsync(e))" @onclick="@(() => Reveal(b.TipSha))" @ondblclick="@(() => CheckoutRemote(b))">
                                    <MudIcon Icon="@Icons.Material.Outlined.Cloud" Size="Size.Small" Class="gf-dim" />
                                    <span class="gf-ellipsis gf-grow">@b.Name[(remote.Name.Length + 1)..]</span>
                                    <button class="gf-eye" title="@(hidden ? "Show in graph" : "Hide from graph")" aria-label="@(hidden ? "Show branch" : "Hide branch")"
                                            @onclick:stopPropagation="true" @onclick="@(() => W.ToggleHiddenAsync(b.CanonicalName))">
                                        <MudIcon Icon="@(hidden ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)" Size="Size.Small" />
                                    </button>
                                </div>
                            </ActivatorContent>
                            <ChildContent>
                                <MudMenuItem OnClick="@(() => CheckoutRemote(b))">Checkout as local branch</MudMenuItem>
                                <MudMenuItem OnClick="@(() => Merge(b.Name))">Merge into @W.CurrentBranch</MudMenuItem>
                                <MudMenuItem OnClick="@(() => Rebase(b.Name))">Rebase @W.CurrentBranch onto this</MudMenuItem>
                                <MudDivider />
                                <MudMenuItem OnClick="@(() => W.SoloAsync(b.CanonicalName))">@(W.SoloRef == b.CanonicalName ? "Unsolo" : "Solo in graph")</MudMenuItem>
                                <MudMenuItem OnClick="@(() => W.ToggleHiddenAsync(b.CanonicalName))">@(hidden ? "Show in graph" : "Hide from graph")</MudMenuItem>
                                <MudDivider />
                                <MudMenuItem OnClick="@(() => DeleteRemote(b))"><span class="gf-danger">Delete on @remote.Name…</span></MudMenuItem>
                            </ChildContent>
                        </MudMenu>
                    }
                }
            }
            @if (s.Remotes.Count == 0)
            {
                <div class="gf-empty gf-small">No remotes</div>
            }
        </SideSection>

        @if (W.DefaultRemote?.Hosted is { } hosted)
        {
            <SideSection Title="Pull requests" Count="_prs?.Count ?? 0" Expanded="_prsOpen" ExpandedChanged="TogglePrs">
                @if (_prAccount is null)
                {
                    <div class="gf-empty gf-small">Add a @hosted.Provider account for @hosted.Host to list pull requests.</div>
                }
                else if (_prs is null)
                {
                    <div class="gf-empty gf-small">Loading…</div>
                }
                else
                {
                    @foreach (var pr in _prs)
                    {
                        <div class="gf-ref-row" title="@($"{pr.SourceBranch} → {pr.TargetBranch} · {pr.Author}")" @onclick="@(() => Shell.OpenUrl(pr.WebUrl))">
                            <MudIcon Icon="@Icons.Material.Outlined.MergeType" Size="Size.Small" Class="gf-dim" />
                            <span class="gf-ellipsis gf-grow">@(pr.IsDraft ? "[Draft] " : null)@pr.Title</span>
                            <span class="gf-dim gf-small">#@pr.Id</span>
                        </div>
                    }
                    @if (_prs.Count == 0)
                    {
                        <div class="gf-empty gf-small">No open pull requests</div>
                    }
                }
            </SideSection>
        }

        <SideSection Title="Tags" Count="s.Tags.Count" @bind-Expanded="_tagsOpen">
            @foreach (var t in Filter(s.Tags, t => t.Name).Take(300))
            {
                <MudMenu ActivationEvent="@MouseEvent.RightClick" PositionAtCursor="true" Dense="true" FullWidth="true">
                    <ActivatorContent Context="menu">
                        <div class="gf-ref-row" title="@(t.Message ?? t.TargetSha)" @oncontextmenu="@(e => menu.OpenAsync(e))" @onclick="@(() => Reveal(t.TargetSha))">
                            <MudIcon Icon="@Icons.Material.Outlined.LocalOffer" Size="Size.Small" Class="gf-dim" />
                            <span class="gf-ellipsis gf-grow">@t.Name</span>
                        </div>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem OnClick="@(() => W.CheckoutAsync(t.Name))">Checkout (detached)</MudMenuItem>
                        <MudMenuItem OnClick="@(() => PushTag(t))">Push tag to @(W.DefaultRemote?.Name ?? "remote")</MudMenuItem>
                        <MudMenuItem OnClick="@(() => DeleteTag(t))"><span class="gf-danger">Delete…</span></MudMenuItem>
                    </ChildContent>
                </MudMenu>
            }
        </SideSection>

        <SideSection Title="Stashes" Count="s.Stashes.Count" @bind-Expanded="_stashesOpen">
            @foreach (var st in s.Stashes)
            {
                <MudMenu ActivationEvent="@MouseEvent.RightClick" PositionAtCursor="true" Dense="true" FullWidth="true">
                    <ActivatorContent Context="menu">
                        <div class="gf-ref-row @(W.Center == CenterView.Stash && W.OpenStashSha == st.Sha ? "selected" : null)"
                             title="@($"{st.RefSpec} · {st.When.LocalDateTime:g}\nClick to preview · double-click to apply")"
                             @oncontextmenu="@(e => menu.OpenAsync(e))" @onclick="@(() => W.ShowStash(st))" @ondblclick="@(() => ApplyStash(st, false))">
                            <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Size="Size.Small" Class="gf-dim" />
                            <span class="gf-ellipsis gf-grow">@st.Message</span>
                        </div>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem OnClick="@(() => W.ShowStash(st))">Show changes</MudMenuItem>
                        <MudMenuItem OnClick="@(() => ApplyStash(st, false))">Apply</MudMenuItem>
                        <MudMenuItem OnClick="@(() => ApplyStash(st, true))">Pop (apply and drop)</MudMenuItem>
                        <MudMenuItem OnClick="@(() => DropStash(st))"><span class="gf-danger">Drop…</span></MudMenuItem>
                    </ChildContent>
                </MudMenu>
            }
        </SideSection>

        @if (W.Lfs.InUse)
        {
            var lfs = W.Lfs;
            <SideSection Title="LFS" Count="lfs.Locks.Locks.Count" @bind-Expanded="_lfsOpen">
                <div class="gf-side-actions">
                    <button class="gf-link-button" @onclick="W.RefreshLocksAsync" title="Fetch locks from the LFS server">
                        <MudIcon Icon="@Icons.Material.Outlined.Refresh" Size="Size.Small" /> Refresh locks
                    </button>
                    <span class="gf-dim gf-small">@lfs.Files.Count file@(lfs.Files.Count == 1 ? string.Empty : "s") in LFS</span>
                </div>
                <div class="gf-lfs-patterns">
                    @foreach (var p in lfs.Patterns)
                    {
                        <span class="gf-chip" title="@($"from {p.Source}")">@p.Pattern@(p.Lockable ? " 🔒" : null)</span>
                    }
                </div>
                @if (lfs.Locks.Error is { } err)
                {
                    <div class="gf-lfs-error gf-small">@err</div>
                }
                @foreach (var l in Filter(lfs.Locks.Locks, x => x.Path))
                {
                    var mine = l.IsOurs == true;
                    <MudMenu ActivationEvent="@MouseEvent.RightClick" PositionAtCursor="true" Dense="true" FullWidth="true">
                        <ActivatorContent Context="menu">
                            <div class="gf-ref-row" title="@($"{l.Path}\nLocked by {(mine ? "you" : l.Owner)}{(l.LockedAt is { } at ? $" on {at.LocalDateTime:g}" : null)}")" @oncontextmenu="@(e => menu.OpenAsync(e))">
                                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Class="@(mine ? "gf-current-icon" : "gf-warn")" />
                                <span class="gf-ellipsis gf-grow">@System.IO.Path.GetFileName(l.Path)</span>
                                <span class="gf-dim gf-small gf-nowrap">@(mine ? "you" : l.Owner)</span>
                            </div>
                        </ActivatorContent>
                        <ChildContent>
                            @if (l.IsOurs != false)
                            {
                                <MudMenuItem OnClick="@(() => W.UnlockFileAsync(l.Path, force: false))">Unlock</MudMenuItem>
                            }
                            @if (l.IsOurs != true)
                            {
                                <MudMenuItem OnClick="@(() => ForceUnlock(l))"><span class="gf-danger">Force unlock (break @l.Owner's lock)…</span></MudMenuItem>
                            }
                        </ChildContent>
                    </MudMenu>
                }
                @if (lfs.Locks.Locks.Count == 0 && lfs.Locks.Error is null)
                {
                    <div class="gf-empty gf-small">No locked files</div>
                }
            </SideSection>
        }

        @if (s.Submodules.Count > 0)
        {
            <SideSection Title="Submodules" Count="SubmoduleRows.Count" @bind-Expanded="_submodulesOpen">
                <div class="gf-side-actions">
                    <button class="gf-link-button" @onclick="W.UpdateSubmodulesAsync" title="git submodule sync + update --init --recursive (skips submodules with local changes)">
                        <MudIcon Icon="@Icons.Material.Outlined.Sync" Size="Size.Small" /> Update all (recursive)
                    </button>
                    @if (W.Settings.AutoUpdateSubmodules)
                    {
                        <span class="gf-chip" title="Submodules follow checkouts, pulls, merges, rebases, resets, and undo automatically. Change in Settings.">auto</span>
                    }
                </div>
                @foreach (var row in SubmoduleRows)
                {
                    var top = row.Depth == 0;
                    <MudMenu ActivationEvent="@MouseEvent.RightClick" PositionAtCursor="true" Dense="true" FullWidth="true">
                        <ActivatorContent Context="menu">
                            <div class="gf-ref-row" style="padding-left:@(18 + (row.Depth * 16))px" title="@row.Tooltip"
                                 @oncontextmenu="@(e => menu.OpenAsync(e))" @ondblclick="@(() => W.OpenAsync(Path.Combine(s.WorkingDirectory, row.Path)))">
                                <MudIcon Icon="@(top ? Icons.Material.Outlined.Extension : Icons.Material.Outlined.SubdirectoryArrowRight)" Size="Size.Small" Class="gf-dim" />
                                <span class="gf-ellipsis gf-grow">@row.Name</span>
                                @switch (row.State)
                                {
                                    case SubmoduleSyncState.NotInitialized: <span class="gf-pill gone">uninit</span> break;
                                    case SubmoduleSyncState.OutOfSync: <span class="gf-pill behind">out of sync</span> break;
                                    case SubmoduleSyncState.Conflicted: <span class="gf-pill gone">conflict</span> break;
                                }
                                @if (row.Dirty) { <span class="gf-pill ahead" title="Uncommitted changes inside the submodule">dirty</span> }
                            </div>
                        </ActivatorContent>
                        <ChildContent>
                            <MudMenuItem Disabled="@(!top)" OnClick="@(() => W.UpdateSubmoduleAsync(row.Path))">Update @row.Name (recursive)</MudMenuItem>
                            <MudMenuItem OnClick="@(() => W.OpenAsync(Path.Combine(s.WorkingDirectory, row.Path)))">Open in GitForge</MudMenuItem>
                            <MudMenuItem OnClick="@(() => Shell.RevealInFileManager(Path.Combine(s.WorkingDirectory, row.Path)))">Show in Explorer</MudMenuItem>
                        </ChildContent>
                    </MudMenu>
                }
            </SideSection>
        }

        <div class="gf-left-footer">
            <button class="gf-link-button" @onclick="W.ShowReflog"><MudIcon Icon="@Icons.Material.Outlined.Restore" Size="Size.Small" /> Reflog — recover lost work</button>
        </div>
    }
</div>

@code {
    private string _filter = string.Empty;
    private string? _dropOn; // local branch under a dragged branch
    private bool _localOpen = true, _remoteOpen = true, _prsOpen = true, _tagsOpen, _stashesOpen = true, _submodulesOpen = true, _lfsOpen = true;
    private readonly HashSet<string> _closedFolders = [];
    private IReadOnlyList<HostedPullRequest>? _prs;
    private HostingAccount? _prAccount;
    private string? _prsLoadedFor;

    private sealed record SubmoduleRow(string Path, string Name, int Depth, SubmoduleSyncState State, bool Dirty, string Tooltip);

    /// <summary>Nested rows from <c>git submodule status --recursive</c>, enriched with dirty state for top-level submodules.</summary>
    private IReadOnlyList<SubmoduleRow> SubmoduleRows
    {
        get
        {
            var snapshot = W.Snapshot;
            var byPath = snapshot?.Submodules.ToDictionary(m => m.Path, StringComparer.Ordinal) ?? [];
            if (W.SubmoduleStatus.Count > 0)
            {
                return W.SubmoduleStatus.Select(e =>
                {
                    byPath.TryGetValue(e.Path, out var info);
                    var dirty = info?.State.HasFlag(SubmoduleState.WorkDirDirty) == true;
                    return new SubmoduleRow(e.Path, e.Name, e.Depth, e.State, dirty,
                        $"{e.Path} · {e.Sha[..Math.Min(8, e.Sha.Length)]}{(e.State == SubmoduleSyncState.NotInitialized ? null : e.Branch is null ? " (detached)" : $" on {e.Branch}")}{(info is null ? null : $" · {info.Url}")}");
                }).ToList();
            }

            // Fallback before the recursive status arrives: top-level submodules from libgit2.
            return (snapshot?.Submodules ?? []).Select(m => new SubmoduleRow(
                m.Path, m.Name, 0,
                m.State.HasFlag(SubmoduleState.NotInitialized) ? SubmoduleSyncState.NotInitialized
                    : m.State.HasFlag(SubmoduleState.OutOfSync) ? SubmoduleSyncState.OutOfSync : SubmoduleSyncState.Current,
                m.State.HasFlag(SubmoduleState.WorkDirDirty), $"{m.Path} · {m.Url}")).ToList();
        }
    }

    protected override void OnInitialized() => W.Changed += OnChanged;

    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        await LoadPullRequestsAsync();
        StateHasChanged();
    });

    protected override Task OnInitializedAsync() => LoadPullRequestsAsync();

    private async Task LoadPullRequestsAsync()
    {
        var hosted = W.DefaultRemote?.Hosted;
        var key = hosted is null ? null : $"{hosted.Host}/{hosted.FullName}";
        if (key == _prsLoadedFor) return;
        _prsLoadedFor = key;
        _prs = null;
        _prAccount = hosted is null ? null : Accounts.FindAccountFor(hosted);
        if (hosted is null || _prAccount is null) return;
        try
        {
            var token = await Accounts.GetTokenAsync(_prAccount) ?? throw new InvalidOperationException("Token not found in the keyring.");
            _prs = await Accounts.GetProvider(hosted.Provider).ListPullRequestsAsync(_prAccount, token, hosted);
        }
        catch (Exception ex)
        {
            _prs = [];
            W.Error("List pull requests", ex);
        }
    }

    private Task TogglePrs(bool open)
    {
        _prsOpen = open;
        return Task.CompletedTask;
    }

    private IEnumerable<T> Filter<T>(IEnumerable<T> items, Func<T, string> name) =>
        string.IsNullOrWhiteSpace(_filter) ? items : items.Where(i => name(i).Contains(_filter, StringComparison.OrdinalIgnoreCase));

    /// <summary>Groups "feature/x" style names under a folder; names without '/' have a null key and list first.</summary>
    private static IEnumerable<IGrouping<string?, BranchHead>> Group(IEnumerable<BranchHead> branches) =>
        branches.GroupBy(b => b.Name.Contains('/', StringComparison.Ordinal) ? b.Name[..b.Name.IndexOf('/', StringComparison.Ordinal)] : null)
                .OrderBy(g => g.Key is null ? 0 : 1).ThenBy(g => g.Key, StringComparer.OrdinalIgnoreCase);

    private bool IsFolderOpen(string key) => !_closedFolders.Contains(key) || !string.IsNullOrWhiteSpace(_filter);

    private void ToggleFolder(string key)
    {
        if (!_closedFolders.Remove(key)) _closedFolders.Add(key);
    }

    private static string ProviderIcon(HostingProviderKind? kind) => kind switch
    {
        HostingProviderKind.GitHub => Icons.Custom.Brands.GitHub,
        _ => Icons.Material.Outlined.Cloud,
    };

    private void Reveal(string? sha)
    {
        if (sha is null) return;
        W.ShowGraph();
        W.SelectCommit(sha, reveal: true);
    }

    private void DragEnter(BranchHead b)
    {
        if (BranchDragDrop.CanDrop(W.DraggedBranch, b)) _dropOn = b.CanonicalName;
    }

    private void DragLeave(BranchHead b)
    {
        if (_dropOn == b.CanonicalName) _dropOn = null;
    }

    private Task Drop(BranchHead b)
    {
        _dropOn = null;
        return BranchDragDrop.DropAsync(W, Dialogs, b);
    }

    private Task Checkout(BranchHead b) => b.IsCurrent ? Task.CompletedTask : W.CheckoutAsync(b.Name);

    private Task CheckoutRemote(BranchHead b)
    {
        var local = b.Name[(b.RemoteName!.Length + 1)..];
        var existing = W.Snapshot?.LocalBranches.FirstOrDefault(l => l.Name == local);
        return existing is not null
            ? Checkout(existing)
            : W.RunAsync($"Checking out {local}", (r, _) => r.Branches.CheckoutRemoteBranchAsync(b.Name, local), $"Created {local} tracking {b.Name}");
    }

    private async Task Merge(string branch)
    {
        if (await Confirm("Merge", $"Merge {branch} into {W.CurrentBranch}?", "Merge")) await W.RunAsync($"Merging {branch}", (r, _) => r.History.MergeAsync(branch, false));
    }

    private async Task Rebase(string onto)
    {
        if (await Confirm("Rebase", $"Rebase {W.CurrentBranch} onto {onto}? Local commits will be rewritten.", "Rebase")) await W.RunAsync($"Rebasing onto {onto}", (r, _) => r.History.RebaseOntoAsync(onto));
    }

    private Task Push(BranchHead b)
    {
        var remote = b.RemoteName ?? W.DefaultRemote?.Name;
        if (remote is null)
        {
            W.Info("No remote configured.", Severity.Warning);
            return Task.CompletedTask;
        }

        // A deleted upstream is recreated under its old name (it may differ from the local name) and re-linked.
        var remoteBranch = b.IsUpstreamGone && b.UpstreamName is { } up && up.StartsWith(remote + "/", StringComparison.Ordinal) ? up[(remote.Length + 1)..] : null;
        var request = new PushRequest(remote, b.Name, remoteBranch, SetUpstream: !b.HasUpstream || b.IsUpstreamGone);
        return W.RunAsync($"Pushing {b.Name}", (r, p) => r.Remotes.PushAsync(request, p), $"Pushed {b.Name}");
    }

    private Task StopTracking(BranchHead b) =>
        W.RunAsync($"Unlinking {b.Name}", (r, _) => r.Branches.SetUpstreamAsync(b.Name, null), $"{b.Name} no longer tracks {b.UpstreamName}");

    private static string GoneTip(BranchHead b) =>
        $"{b.UpstreamName} was deleted on the remote, usually after its pull request merged. A fetch then removed the remote copy. " +
        "Your local branch and its commits are untouched. Right-click to delete it, push it again, or stop tracking.";

    private static List<BranchHead> GoneBranches(RepositorySnapshot s) => s.LocalBranches.Where(b => b.IsUpstreamGone && !b.IsCurrent).ToList();

    private async Task CleanUpGone(IReadOnlyList<BranchHead> gone)
    {
        var names = gone.Select(b => b.Name).ToList();
        var list = string.Join(", ", names.Take(15)) + (names.Count > 15 ? $", and {names.Count - 15} more" : string.Empty);
        var message = $"Their copies on the remote were deleted: {list}. " +
                      $"GitForge deletes only branches whose commits are already in {W.CurrentBranch ?? "HEAD"}, so no work is lost. " +
                      "Branches with other commits (common after squash merges) are kept for you to review.";
        if (await Confirm("Clean up branches", message, "Delete merged")) await W.CleanUpGoneBranchesAsync(names);
    }

    private void CreatePr(BranchHead b)
    {
        var remote = W.Snapshot?.Remotes.FirstOrDefault(r => r.Name == (b.RemoteName ?? W.DefaultRemote?.Name));
        if (remote?.Hosted is not { } hosted)
        {
            W.Info("The remote is not a recognized hosting provider. Add an account for self-hosted servers.", Severity.Warning);
            return;
        }

        var target = W.Snapshot?.RemoteBranches.Any(r => r.Name == $"{remote.Name}/main") == true ? "main" : "master";
        Shell.OpenUrl(Accounts.GetProvider(hosted.Provider).GetCreatePullRequestUrl(Accounts.FindAccountFor(hosted), hosted, b.Name, target));
    }

    private async Task Rename(BranchHead b)
    {
        var name = await TextPromptDialog.ShowAsync(Dialogs, "Rename branch", "New name", b.Name, validateRef: true);
        if (name is not null && name != b.Name) await W.RunAsync("Renaming branch", (r, _) => r.Branches.RenameAsync(b.Name, name));
    }

    private async Task Delete(BranchHead b)
    {
        var result = await Dialogs.ShowMessageBoxAsync("Delete branch", $"Delete local branch '{b.Name}'? {Keymap.UndoName(W.Settings)} restores it until your next action.", yesText: "Delete", noText: "Force delete", cancelText: "Cancel");
        if (result is null) return;
        await W.RunUndoableAsync($"Deleting {b.Name}", r => UndoableOperations.DeleteBranchAsync(r, b.Name, force: result == false), $"Deleted {b.Name} ({Keymap.UndoName(W.Settings)} reverses it)");
    }

    private async Task DeleteRemote(BranchHead b)
    {
        var branch = b.Name[(b.RemoteName!.Length + 1)..];
        if (await Confirm("Delete remote branch", $"Delete '{branch}' on {b.RemoteName}? This affects everyone using the remote and cannot be undone here.", "Delete"))
        {
            await W.RunAsync($"Deleting {b.Name}", (r, p) => r.Branches.DeleteRemoteAsync(b.RemoteName!, branch, p));
        }
    }

    private Task PushTag(TagInfo t)
    {
        var remote = W.DefaultRemote?.Name;
        return remote is null ? Task.CompletedTask : W.RunAsync($"Pushing tag {t.Name}", (r, p) => r.RunRawAsync(["push", "--progress", remote, $"refs/tags/{t.Name}"], p));
    }

    private async Task DeleteTag(TagInfo t)
    {
        if (await Confirm("Delete tag", $"Delete local tag '{t.Name}'?", "Delete")) await W.RunAsync($"Deleting tag {t.Name}", (r, _) => r.Branches.DeleteTagAsync(t.Name));
    }

    private Task ApplyStash(StashInfo st, bool pop) => W.RunAsync(pop ? "Popping stash" : "Applying stash", (r, _) => r.Stashes.ApplyAsync(st.Index, pop, restoreIndex: false));

    private async Task DropStash(StashInfo st)
    {
        if (await Confirm("Drop stash", $"Drop '{st.Message}'? It cannot be recovered from the UI afterwards.", "Drop")) await W.RunAsync("Dropping stash", (r, _) => r.Stashes.DropAsync(st.Index));
    }

    private async Task ForceUnlock(LfsLock l)
    {
        if (await Confirm("Break LFS lock", $"Break {l.Owner}'s lock on '{l.Path}'? They may lose the right to push their changes to it. Your server must allow this.", "Force unlock"))
        {
            await W.UnlockFileAsync(l.Path, force: true);
        }
    }

    private async Task<bool> Confirm(string title, string message, string yes) =>
        await Dialogs.ShowMessageBoxAsync(title, message, yesText: yes, cancelText: "Cancel") == true;

    public void Dispose() => W.Changed -= OnChanged;
}
