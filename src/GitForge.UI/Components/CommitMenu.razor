@using GitForge.Git.Undo
@inject RepoWorkspace W
@inject IDialogService Dialogs
@inject IJSRuntime JS

<MudMenuItem Icon="@Icons.Material.Outlined.Login" OnClick="Checkout">Checkout (detached)</MudMenuItem>
<MudMenuItem Icon="@Icons.Material.Outlined.CallSplit" OnClick="NewBranch">New branch here…</MudMenuItem>
<MudMenuItem Icon="@Icons.Material.Outlined.LocalOffer" OnClick="NewTag">New tag here…</MudMenuItem>
<MudDivider />
@if (InMultiSelection)
{
    <MudMenuItem Icon="@Icons.Material.Outlined.ContentPasteGo" OnClick="CherryPickSelection">Cherry-pick @W.MultiSelection.Count selected commits onto @(W.CurrentBranch ?? "HEAD")…</MudMenuItem>
    @if (W.MultiSelection.Count == 2)
    {
        <MudMenuItem Icon="@Icons.Material.Outlined.CompareArrows" OnClick="CompareSelection">Compare the two selected commits</MudMenuItem>
    }
}
else
{
    <MudMenuItem Icon="@Icons.Material.Outlined.ContentPasteGo" OnClick="CherryPick">Cherry-pick onto @(W.CurrentBranch ?? "HEAD")</MudMenuItem>
}
@if (CompareBase is { } other)
{
    <MudMenuItem Icon="@Icons.Material.Outlined.CompareArrows" OnClick="@(() => W.CompareCommits(other, Commit.Sha))">Compare with selected (@other[..7])</MudMenuItem>
}
<MudMenuItem Icon="@Icons.Material.Outlined.Difference" OnClick="@(() => W.ShowCompare(Commit.Sha, null))">Compare with working tree</MudMenuItem>
<MudMenuItem Icon="@Icons.Material.Outlined.Undo" OnClick="Revert">Revert commit</MudMenuItem>
<MudMenuItem Icon="@Icons.Material.Outlined.Reorder" OnClick="InteractiveRebase">Interactive rebase children…</MudMenuItem>
<MudDivider />
<MudMenuItem OnClick="@(() => Reset(ResetMode.Soft))">Reset @(W.CurrentBranch ?? "HEAD") here — soft (keep index)</MudMenuItem>
<MudMenuItem OnClick="@(() => Reset(ResetMode.Mixed))">Reset @(W.CurrentBranch ?? "HEAD") here — mixed (keep files)</MudMenuItem>
<MudMenuItem OnClick="@(() => Reset(ResetMode.Hard))"><span class="gf-danger">Reset @(W.CurrentBranch ?? "HEAD") here — hard (discard)…</span></MudMenuItem>
<MudDivider />
<MudMenuItem Icon="@Icons.Material.Outlined.ContentCopy" OnClick="CopySha">Copy SHA</MudMenuItem>

@code {
    [Parameter, EditorRequired] public CommitInfo Commit { get; set; } = default!;

    private Task Run(string label, Func<IGitRepository, Task> op, string? success = null) => W.RunAsync(label, (r, _) => op(r), success);

    private Task Checkout() => W.CheckoutAsync(Commit.Sha);

    private async Task NewBranch()
    {
        var name = await TextPromptDialog.ShowAsync(Dialogs, $"New branch at {Commit.ShortSha}", "Branch name", string.Empty, validateRef: true);
        if (name is not null) await W.RunUndoableAsync($"Creating {name}", r => UndoableOperations.CreateBranchAsync(r, name, Commit.Sha, checkout: true), $"Created and checked out {name}");
    }

    private async Task NewTag()
    {
        var name = await TextPromptDialog.ShowAsync(Dialogs, $"New tag at {Commit.ShortSha}", "Tag name", string.Empty, validateRef: true);
        if (name is null) return;
        var message = await TextPromptDialog.ShowAsync(Dialogs, "Tag message", "Message (leave empty for a lightweight tag)", string.Empty, allowEmpty: true, multiline: true);
        if (message is null) return;
        await Run($"Tagging {name}", r => r.Branches.CreateTagAsync(name, Commit.Sha, message), $"Created tag {name}");
    }

    private Task CherryPick() => Run($"Cherry-picking {Commit.ShortSha}", r => r.History.CherryPickAsync([Commit.Sha]));

    private bool InMultiSelection => W.MultiSelection.Count > 1 && W.MultiSelection.Contains(Commit.Sha);

    /// <summary>The single selected commit this one can be compared with (none while several are selected).</summary>
    private string? CompareBase => W.MultiSelection.Count == 0 && !W.WipSelected && W.SelectedCommitSha is { } s && s != Commit.Sha ? s : null;

    private void CompareSelection()
    {
        if (W.SelectedCommitsOldestFirst() is [var a, var b]) W.CompareCommits(a.Sha, b.Sha);
    }

    private async Task CherryPickSelection()
    {
        var count = W.MultiSelection.Count;
        var target = W.CurrentBranch ?? "HEAD";
        if (await Dialogs.ShowMessageBoxAsync("Cherry-pick commits", $"Cherry-pick {count} commits onto {target}, oldest first? If one conflicts, GitForge stops so you can resolve it, then continue or abort.", yesText: "Cherry-pick", cancelText: "Cancel") == true)
        {
            await W.CherryPickSelectionAsync();
        }
    }

    private async Task Revert()
    {
        if (await Dialogs.ShowMessageBoxAsync("Revert commit", $"Create a new commit that reverts {Commit.ShortSha} \"{Commit.Subject}\"?", yesText: "Revert", cancelText: "Cancel") == true)
        {
            await Run($"Reverting {Commit.ShortSha}", r => r.History.RevertAsync(Commit.Sha));
        }
    }

    private async Task Reset(ResetMode mode)
    {
        if (mode == ResetMode.Hard &&
            await Dialogs.ShowMessageBoxAsync("Hard reset", $"Move {W.CurrentBranch ?? "HEAD"} to {Commit.ShortSha} and DISCARD all uncommitted changes? Committed work stays recoverable via the reflog.", yesText: "Reset hard", cancelText: "Cancel") != true)
        {
            return;
        }

        await W.RunUndoableAsync($"Resetting to {Commit.ShortSha}", r => UndoableOperations.ResetAsync(r, Commit.Sha, mode), $"Reset complete ({Keymap.UndoName(W.Settings)} reverses it)");
    }

    private async Task InteractiveRebase()
    {
        if (!W.Status.IsClean)
        {
            W.Info("Commit or stash your changes before an interactive rebase.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters<InteractiveRebaseDialog> { { d => d.BaseSha, Commit.Sha } };
        var dialog = await Dialogs.ShowAsync<InteractiveRebaseDialog>($"Interactive rebase onto {Commit.ShortSha}", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
        await dialog.Result;
    }

    private async Task CopySha()
    {
        await JS.InvokeVoidAsync("gitforge.copyText", Commit.Sha);
        W.Info($"Copied {Commit.ShortSha}");
    }
}
