@inject RepoWorkspace W
@inject IDialogService Dialogs
@inject IPlatformShell Shell
@inject IJSRuntime JS

<MudMenuItem Icon="@Icons.Material.Outlined.Login" OnClick="Checkout">Checkout (detached)</MudMenuItem>
<MudMenuItem Icon="@Icons.Material.Outlined.CallSplit" OnClick="@(() => CommitActions.NewBranchAsync(W, Dialogs, Commit))">New branch here…</MudMenuItem>
<MudMenuItem Icon="@Icons.Material.Outlined.LocalOffer" OnClick="@(() => CommitActions.NewTagAsync(W, Dialogs, Commit))">New tag here…</MudMenuItem>
<MudDivider />
@if (InMultiSelection)
{
    <MudMenuItem Icon="@Icons.Material.Outlined.ContentPasteGo" OnClick="CherryPickSelection">Cherry-pick @W.MultiSelection.Count selected commits onto @(W.CurrentBranch ?? "HEAD")…</MudMenuItem>
    @if (W.MultiSelection.Count == 2)
    {
        <MudMenuItem Icon="@Icons.Material.Outlined.CompareArrows" OnClick="CompareSelection">Compare the two selected commits</MudMenuItem>
    }
}
else
{
    <MudMenuItem Icon="@Icons.Material.Outlined.ContentPasteGo" OnClick="@(() => CommitActions.CherryPickAsync(W, Commit))">Cherry-pick onto @(W.CurrentBranch ?? "HEAD")</MudMenuItem>
}
@if (CompareBase is { } other)
{
    <MudMenuItem Icon="@Icons.Material.Outlined.CompareArrows" OnClick="@(() => W.CompareCommits(other, Commit.Sha))">Compare with selected (@other[..7])</MudMenuItem>
}
<MudMenuItem Icon="@Icons.Material.Outlined.Difference" OnClick="@(() => W.ShowCompare(Commit.Sha, null))">Compare with working tree</MudMenuItem>
<MudMenuItem Icon="@Icons.Material.Outlined.Undo" OnClick="@(() => CommitActions.RevertAsync(W, Dialogs, Commit))">Revert commit</MudMenuItem>
<MudMenuItem Icon="@Icons.Material.Outlined.Reorder" OnClick="@(() => CommitActions.InteractiveRebaseAsync(W, Dialogs, Commit))">Interactive rebase children…</MudMenuItem>
<MudMenuItem Icon="@Icons.Material.Outlined.Description" OnClick="SavePatches">@(InMultiSelection ? $"Save {W.MultiSelection.Count} selected commits as patches…" : "Save as patch…")</MudMenuItem>
<MudMenu Label="Bisect" StartIcon="@Icons.Material.Outlined.ManageSearch" Dense="true">
    @if (W.IsBisecting)
    {
        <MudMenuItem OnClick="@(() => CommitActions.BisectAsync(W, Commit, BisectMark.Good))">Mark good (the bug isn't here)</MudMenuItem>
        <MudMenuItem OnClick="@(() => CommitActions.BisectAsync(W, Commit, BisectMark.Bad))">Mark bad (the bug is here)</MudMenuItem>
        <MudMenuItem OnClick="@(() => W.MarkBisectAsync(BisectMark.Skip, Commit.Sha))">Skip (can't be tested)</MudMenuItem>
        <MudMenuItem OnClick="W.ResetBisectAsync">End bisect</MudMenuItem>
    }
    else
    {
        <MudMenuItem OnClick="@(() => CommitActions.BisectAsync(W, Commit, BisectMark.Bad))">Start: the bug is in this commit</MudMenuItem>
        <MudMenuItem OnClick="@(() => CommitActions.BisectAsync(W, Commit, BisectMark.Good))">Start: this commit works</MudMenuItem>
    }
</MudMenu>
<MudDivider />
<MudMenuItem OnClick="@(() => CommitActions.ResetAsync(W, Dialogs, Commit, ResetMode.Soft))">Reset @(W.CurrentBranch ?? "HEAD") here — soft (keep index)</MudMenuItem>
<MudMenuItem OnClick="@(() => CommitActions.ResetAsync(W, Dialogs, Commit, ResetMode.Mixed))">Reset @(W.CurrentBranch ?? "HEAD") here — mixed (keep files)</MudMenuItem>
<MudMenuItem OnClick="@(() => CommitActions.ResetAsync(W, Dialogs, Commit, ResetMode.Hard))"><span class="gf-danger">Reset @(W.CurrentBranch ?? "HEAD") here — hard (discard)…</span></MudMenuItem>
<MudDivider />
<MudMenuItem Icon="@Icons.Material.Outlined.ContentCopy" OnClick="CopySha">Copy SHA</MudMenuItem>

@code {
    [Parameter, EditorRequired] public CommitInfo Commit { get; set; } = default!;

    private Task Checkout() => W.CheckoutAsync(Commit.Sha);

    private bool InMultiSelection => W.MultiSelection.Count > 1 && W.MultiSelection.Contains(Commit.Sha);

    /// <summary>The single selected commit this one can be compared with (none while several are selected).</summary>
    private string? CompareBase => W.MultiSelection.Count == 0 && !W.WipSelected && W.SelectedCommitSha is { } s && s != Commit.Sha ? s : null;

    private void CompareSelection()
    {
        if (W.SelectedCommitsOldestFirst() is [var a, var b]) W.CompareCommits(a.Sha, b.Sha);
    }

    private async Task CherryPickSelection()
    {
        var count = W.MultiSelection.Count;
        var target = W.CurrentBranch ?? "HEAD";
        if (await Dialogs.ShowMessageBoxAsync("Cherry-pick commits", $"Cherry-pick {count} commits onto {target}, oldest first? If one conflicts, GitForge stops so you can resolve it, then continue or abort.", yesText: "Cherry-pick", cancelText: "Cancel") == true)
        {
            await W.CherryPickSelectionAsync();
        }
    }

    private Task SavePatches() =>
        CommitActions.SavePatchesAsync(W, Shell, Dialogs, InMultiSelection ? W.SelectedCommitsOldestFirst() : [Commit]);

    private async Task CopySha()
    {
        await JS.InvokeVoidAsync("gitforge.copyText", Commit.Sha);
        W.Info($"Copied {Commit.ShortSha}");
    }
}
