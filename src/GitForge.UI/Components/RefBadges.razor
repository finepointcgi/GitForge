@if (Labels is { Count: > 0 })
{
    @foreach (var l in Labels)
    {
        <span class="gf-ref @Css(l)" title="@l.Name">@(l.IsCurrent && l.Kind == RefKind.LocalBranch ? "● " : null)@l.Name</span>
    }
}

@code {
    [Parameter] public IReadOnlyList<RefLabel>? Labels { get; set; }

    private static string Css(RefLabel l) => l.Kind switch
    {
        RefKind.Head => "head",
        RefKind.LocalBranch => l.IsCurrent ? "local current" : "local",
        RefKind.RemoteBranch => "remote",
        RefKind.Tag => "tag",
        RefKind.Stash => "stash",
        _ => string.Empty,
    };
}
