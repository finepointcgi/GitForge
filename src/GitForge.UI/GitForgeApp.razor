@implements IAsyncDisposable
@inject RepoWorkspace W
@inject ShortcutService Shortcuts
@inject IDialogService Dialogs
@inject ISettingsStore SettingsStore
@inject IGitCli Cli
@inject StartupOptions Startup
@inject UpdateService Updates
@inject ISnackbar Snackbar
@inject IPlatformShell Shell

<MudThemeProvider @ref="_themeProvider" Theme="_theme" IsDarkMode="_dark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<CascadingValue Value="_dark" Name="IsDark">
<div class="gf-shell @(_dark ? "dark" : "light")">
    <RepoTabs />
    <Toolbar Dark="_dark" />

    @if (W.IsBusy)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Size="Size.Small" Class="gf-busy-bar" />
    }

    <OperationBanner />

    <div class="gf-body @(W.Repo is null ? "no-repo" : null)" id="gf-body">
        <aside class="gf-left">
            <LeftPanel />
        </aside>
        <div class="gf-splitter gf-splitter-x" data-var="--gf-left-w" data-target="gf-body" data-min="180" data-max="520"></div>
        <main class="gf-center">
            @if (W.Repo is null)
            {
                <WelcomeView />
            }
            else
            {
                @switch (W.Center)
                {
                    case CenterView.Diff:
                        <DiffPane @key="W.OpenDiff" />
                        break;
                    case CenterView.Reflog:
                        <ReflogView />
                        break;
                    case CenterView.FileHistory:
                        <FileHistoryView @key="W.OpenFileView" />
                        break;
                    case CenterView.Blame:
                        <BlameView @key="W.OpenFileView" />
                        break;
                    case CenterView.BranchChanges:
                        <BranchChangesView @key="(W.BranchCompare, W.CurrentBranch)" />
                        break;
                    case CenterView.Stash:
                        <StashView @key="W.OpenStashSha" />
                        break;
                    case CenterView.Compare:
                        <CompareView @key="W.CommitCompare" />
                        break;
                    default:
                        <GraphView />
                        break;
                }
            }
        </main>
        @if (W.Repo is not null)
        {
            <div class="gf-splitter gf-splitter-x" data-var="--gf-right-w" data-target="gf-body" data-invert="1" data-min="300" data-max="2400" data-max-ratio="0.6"></div>
            <aside class="gf-right">
                <CommitPanel />
            </aside>
        }
    </div>

    @if (W.ConsoleOpen && W.Repo is not null)
    {
        <ConsolePanel />
    }

    <footer class="gf-statusbar">
        @if (W.IsBusy)
        {
            <span class="gf-status-busy">@W.BusyText…</span>
            <span class="gf-mono gf-ellipsis">@W.ProgressText</span>
        }
        else if (W.Snapshot is { } s)
        {
            <span class="gf-dim gf-mono gf-ellipsis">@s.WorkingDirectory</span>
            @if (W.CurrentBranchHead is { IsUpstreamGone: true } g)
            {
                <span class="gf-status-warn" title="@g.UpstreamName was deleted on the remote (usually after its pull request merged). Your local commits are safe. Push to recreate it, or switch to another branch and delete this one.">
                    @g.Name → @g.UpstreamName deleted on the remote
                </span>
            }
            else if (W.CurrentBranchHead is { HasUpstream: true } h)
            {
                <span class="gf-dim">@h.Name ⇄ @h.UpstreamName  ↑@(h.Ahead ?? 0) ↓@(h.Behind ?? 0)</span>
            }
            @if (W.HistoryLoading)
            {
                <span class="gf-dim">loading history… @W.Rows.Count.ToString("N0", CultureInfo.CurrentCulture)</span>
            }
        }
        <span class="gf-spacer"></span>
        @if (Updates.Available is { } update && Updates.CanUpdate)
        {
            <button class="gf-status-update" title="GitForge @update.Version is available (you have @Updates.CurrentVersion)" @onclick="ShowUpdates">
                <MudIcon Icon="@Icons.Material.Outlined.SystemUpdateAlt" Style="font-size: 14px;" />
                @(Updates.Status == UpdateStatus.Downloading ? $"Downloading {update.Version}… {Updates.Progress}%" : $"Update to {update.Version}")
            </button>
        }
        @if (W.Undo.CanUndo && !W.IsBusy)
        {
            <span class="gf-dim">@Keymap.UndoName(W.Settings): undo @W.Undo.UndoDescription</span>
        }
        <span class="gf-dim">@_gitVersionText</span>
    </footer>
</div>
</CascadingValue>

@code {
    private MudThemeProvider? _themeProvider;
    private MudTheme _theme = GitForgeTheme.Create(AppSettings.DefaultAccentColor);
    private bool _dark = true;
    private string _gitVersionText = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        StartupTrace.Mark("blazor: app initializing");
        W.Changed += OnChanged;
        Updates.Changed += OnChanged;
        Updates.UpdateFound += OnUpdateFound;
        Shortcuts.Command += OnCommand;
        await W.InitializeAsync();
        _theme = GitForgeTheme.Create(W.Settings.AccentColor);
        Shortcuts.Configure(W.Settings);
        SettingsStore.Changed += OnSettingsChanged;
        StartupTrace.Mark("blazor: settings loaded");

        var started = System.Diagnostics.Stopwatch.GetTimestamp();
        var version = await Cli.GetVersionAsync();
        StartupTrace.Step("git --version", started);
        _gitVersionText = version is null
            ? "git not found — set its path in Settings"
            : version < GitForge.Git.GitEngineOptions.MinimumGitVersion ? $"git {version} (2.39+ required)" : $"git {version}";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        StartupTrace.Mark("blazor: first render");
        await Shortcuts.AttachAsync();
        await ApplyThemePreferenceAsync();
        StartupTrace.Mark("blazor: shortcuts and theme ready");
        var started = System.Diagnostics.Stopwatch.GetTimestamp();
        await W.RestoreTabsAsync(Startup.OpenPath);
        StartupTrace.Step("tabs restored", started);
        Updates.StartAutomaticChecks();
    }

    private void OnUpdateFound(AppUpdate update) => _ = InvokeAsync(() =>
        Snackbar.Add($"GitForge {update.Version} is available.", Severity.Info, o =>
        {
            o.Action = "Details";
            o.ActionColor = Color.Primary;
            o.OnClick = _ => ShowUpdates();
        }));

    private Task ShowUpdates() => Show<UpdateDialog>("Updates");

    private async Task ApplyThemePreferenceAsync()
    {
        if (_themeProvider is null) return;
        _dark = W.Settings.Theme switch
        {
            ThemePreference.Dark => true,
            ThemePreference.Light => false,
            _ => await _themeProvider.GetSystemDarkModeAsync(),
        };
        if (W.Settings.Theme == ThemePreference.System)
        {
            await _themeProvider.WatchSystemDarkModeAsync(dark =>
            {
                if (W.Settings.Theme != ThemePreference.System) return Task.CompletedTask;
                _dark = dark;
                return InvokeAsync(StateHasChanged);
            });
        }

        StateHasChanged();
    }

    private void OnSettingsChanged(object? sender, AppSettings s)
    {
        _theme = GitForgeTheme.Create(s.AccentColor);
        _ = InvokeAsync(async () =>
        {
            await Shortcuts.ApplyAsync(s);
            StateHasChanged();
        });
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task OnCommand(string command)
    {
        var hasRepo = W.Repo is not null;
        switch (command)
        {
            case "view.status" when hasRepo:
                if (W.HasWip) W.SelectWip();
                W.PanelFocused = true;
                W.ShowGraph();
                break;
            case "view.history" when hasRepo:
                W.PanelFocused = false;
                W.ShowGraph();
                break;
            case "view.reflog" when hasRepo: W.ShowReflog(); break;
            case "view.changes" when hasRepo: W.ShowBranchChanges(); break;
            case "graph.head" when hasRepo: W.GoToHead(); break;
            case "escape" when hasRepo && W.Center != CenterView.Graph: W.ShowGraph(); break;
            case "pane.next" when hasRepo:
                W.PanelFocused = true;
                W.Notify();
                break;
            case "pane.prev" when hasRepo:
                W.PanelFocused = false;
                W.Notify();
                break;
            case "tab.next": await W.ActivateRelativeAsync(+1); break;
            case "tab.prev": await W.ActivateRelativeAsync(-1); break;
            case "tab.close" when hasRepo: await W.CloseActiveTabAsync(); break;
            case "edit.undo" when hasRepo: await W.UndoAsync(); break;
            case "edit.redo" when hasRepo: await W.RedoAsync(); break;
            case "repo.open": await Show<OpenRepositoryDialog>("Open repository"); break;
            case "repo.clone": await Show<CloneDialog>("Clone repository", MaxWidth.Medium); break;
            case "repo.refresh": await W.RefreshAsync(RepositoryChangeKind.All); break;
            case "remote.fetch": await W.FetchAsync(); break;
            case "remote.pull": await W.PullAsync(); break;
            case "remote.push": await W.PushAsync(); break;
            case "branch.new" when hasRepo: await Show<NewBranchDialog>("New branch"); break;
            case "branch.cleanup" when hasRepo: await CleanUpBranchesAsync(); break;
            case "stash.save" when hasRepo: await Show<StashDialog>("Stash changes"); break;
            case "stash.pop" when hasRepo: await W.PopStashAsync(); break;
            case "console.toggle" when hasRepo:
                W.ConsoleOpen = !W.ConsoleOpen;
                W.Notify();
                break;
            case "palette.open": await ShowPalette(null); break;
            case "prs.open" when hasRepo: await Show<PullRequestsDialog>("Pull requests", MaxWidth.Medium); break;
            case "accounts.open": await Show<AccountsDialog>("Hosting accounts", MaxWidth.Medium); break;
            case "settings.open": await Show<SettingsDialog>("Settings"); break;
            case "theme.toggle": await ToggleTheme(); break;
            case "help.shortcuts": await Show<ShortcutsDialog>("Keyboard shortcuts", MaxWidth.Medium); break;
            case "app.update": await ShowUpdates(); break;
            case "branch.merge" when hasRepo: await ShowPalette("Merge "); break;
            case "branch.rebase" when hasRepo: await ShowPalette("Rebase "); break;
            case "commit.cherrypick" when hasRepo: await WithSelectedCommit(c => CommitActions.CherryPickAsync(W, c)); break;
            case "commit.revert" when hasRepo: await WithSelectedCommit(c => CommitActions.RevertAsync(W, Dialogs, c)); break;
            case "commit.tag" when hasRepo: await WithSelectedCommit(c => CommitActions.NewTagAsync(W, Dialogs, c)); break;
            case "commit.patch" when hasRepo: await SavePatchesAsync(); break;
            case "worktree.add" when hasRepo: await Show<WorktreeDialog>("New worktree"); break;
            case "bisect.good" when W.IsBisecting: await W.MarkBisectAsync(BisectMark.Good); break;
            case "bisect.bad" when W.IsBisecting: await W.MarkBisectAsync(BisectMark.Bad); break;
            case "bisect.skip" when W.IsBisecting: await W.MarkBisectAsync(BisectMark.Skip); break;
            case "bisect.reset" when W.IsBisecting: await W.ResetBisectAsync(); break;
            case "repo.explorer" when hasRepo: W.RevealInExplorer(); break;
            case "repo.terminal" when hasRepo: W.OpenTerminal(); break;
            case "repo.editor" when hasRepo: W.OpenInEditor(); break;
            case "patch.create" when hasRepo: await SaveUncommittedPatchAsync(); break;
            case "patch.apply" when hasRepo: await ApplyPatchAsync(); break;
            case "bundle.create" when hasRepo: await Show<BundleDialog>("Create bundle"); break;
            case "bundle.fetch" when hasRepo: await FetchBundleAsync(); break;
            case "submodule.add" when hasRepo: await Show<AddSubmoduleDialog>("Add submodule"); break;
            case "submodule.remote" when hasRepo: await W.UpdateSubmodulesToRemoteAsync(); break;
        }
    }

    /// <summary>Runs a commit action on the commit selected in the graph.</summary>
    private Task WithSelectedCommit(Func<CommitInfo, Task> action)
    {
        if (!W.WipSelected && W.SelectedCommitSha is { } sha && W.FindCommit(sha) is { } commit) return action(commit);
        W.Info("Select a commit in the graph first.", Severity.Warning);
        return Task.CompletedTask;
    }

    private Task SavePatchesAsync()
    {
        var commits = W.MultiSelection.Count > 1 ? W.SelectedCommitsOldestFirst() : [];
        return commits.Count > 0 ? CommitActions.SavePatchesAsync(W, Shell, Dialogs, commits) : WithSelectedCommit(c => CommitActions.SavePatchesAsync(W, Shell, Dialogs, [c]));
    }

    private async Task SaveUncommittedPatchAsync()
    {
        if (!W.HasWip)
        {
            W.Info("There are no uncommitted changes to save.", Severity.Warning);
            return;
        }

        var file = await PathPrompt.SaveFileAsync(Shell, Dialogs, "Save uncommitted changes as a patch", $"{W.Repo!.Name}-{DateTime.Now:yyyyMMdd-HHmm}.patch", PathPrompt.PatchFilter);
        if (file is not null) await W.SaveUncommittedPatchAsync(file);
    }

    private async Task ApplyPatchAsync()
    {
        var file = await PathPrompt.OpenFileAsync(Shell, Dialogs, "Apply patch", PathPrompt.PatchFilter);
        if (file is not null) await W.ApplyPatchAsync(file);
    }

    private async Task FetchBundleAsync()
    {
        var file = await PathPrompt.OpenFileAsync(Shell, Dialogs, "Fetch from bundle", PathPrompt.BundleFilter);
        if (file is not null) await W.FetchBundleAsync(file, "bundle");
    }

    /// <summary>Offers to delete local branches whose upstream was deleted on the remote; only fully merged ones are removed.</summary>
    private async Task CleanUpBranchesAsync()
    {
        var names = W.GoneBranches.Select(b => b.Name).ToList();
        if (names.Count == 0)
        {
            W.Info("No local branches to clean up. None of their copies on the remote were deleted.");
            return;
        }

        var list = string.Join(", ", names.Take(15)) + (names.Count > 15 ? $", and {names.Count - 15} more" : string.Empty);
        var message = $"Their copies on the remote were deleted: {list}. " +
                      $"GitForge deletes only branches whose commits are already in {W.CurrentBranch ?? "HEAD"}, so no work is lost. " +
                      "Branches with other commits (common after squash merges) are kept for you to review.";
        if (await Dialogs.ShowMessageBoxAsync("Clean up branches", message, yesText: "Delete merged", cancelText: "Cancel") == true)
        {
            await W.CleanUpGoneBranchesAsync(names);
        }
    }

    private async Task ToggleTheme()
    {
        _dark = !_dark;
        await SettingsStore.UpdateAsync(s => s with { Theme = _dark ? ThemePreference.Dark : ThemePreference.Light });
    }

    private async Task ShowPalette(string? query)
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, NoHeader = true, Position = DialogPosition.TopCenter, CloseOnEscapeKey = true };
        var parameters = new DialogParameters<CommandPalette> { { p => p.InitialQuery, query } };
        var dialog = await Dialogs.ShowAsync<CommandPalette>("Command palette", parameters, options);
        await dialog.Result;
    }

    private async Task Show<TDialog>(string title, MaxWidth width = MaxWidth.Small) where TDialog : IComponent
    {
        var options = new DialogOptions { MaxWidth = width, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true };
        var dialog = await Dialogs.ShowAsync<TDialog>(title, options);
        await dialog.Result;
    }

    public async ValueTask DisposeAsync()
    {
        W.Changed -= OnChanged;
        Updates.Changed -= OnChanged;
        Updates.UpdateFound -= OnUpdateFound;
        Shortcuts.Command -= OnCommand;
        SettingsStore.Changed -= OnSettingsChanged;
        await Shortcuts.DisposeAsync();
    }
}
