@inject ISettingsStore SettingsStore
@inject RepoWorkspace W
@inject IDialogService Dialogs
@inject UpdateService Updates

<MudDialog>
    <DialogContent>
        <div class="gf-form-grid">
            <MudSelect T="ThemePreference" @bind-Value="_s.Theme" Label="Theme" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                @foreach (var t in Enum.GetValues<ThemePreference>())
                {
                    <MudSelectItem T="ThemePreference" Value="t">@t</MudSelectItem>
                }
            </MudSelect>
            <div class="gf-dialog-row">
                <input type="color" value="@_s.AccentColor" @onchange="@(e => _s.AccentColor = e.Value?.ToString() ?? _s.AccentColor)" aria-label="Accent color" />
                <span>Accent color <span class="gf-mono gf-dim">@_s.AccentColor</span></span>
                @if (!string.Equals(_s.AccentColor, AppSettings.DefaultAccentColor, StringComparison.OrdinalIgnoreCase))
                {
                    <button type="button" class="gf-link-button" @onclick="@(() => _s.AccentColor = AppSettings.DefaultAccentColor)">Use GitForge green</button>
                }
            </div>
            <div class="gf-dialog-row">
                <MudCheckBox T="bool" @bind-Value="_s.VimNavigation" Label="Single-key shortcuts, vim-style (j/k, g g, h/l, s/u/d…)" Size="Size.Small" Dense="true" />
                <span class="gf-spacer"></span>
                <button type="button" class="gf-link-button" @onclick="OpenShortcutsAsync">Customize keyboard shortcuts…</button>
            </div>
            <MudCheckBox T="bool" @bind-Value="_s.SyntaxHighlighting" Label="Syntax highlighting in diffs and blame" Size="Size.Small" Dense="true" />
            <MudCheckBox T="bool" @bind-Value="_s.FetchOnOpen" Label="Fetch when a repository opens" Size="Size.Small" Dense="true" />
            <MudCheckBox T="bool" @bind-Value="_s.AutoUpdateSubmodules" Label="Update submodules automatically (recursive) after checkout, pull, merge, rebase, reset, and undo" Size="Size.Small" Dense="true" />
            <MudNumericField T="int" @bind-Value="_s.AutoFetchMinutes" Label="Auto-fetch interval (minutes, 0 = off)" Min="0" Max="240" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudTextField T="string" @bind-Value="_s.GitExecutablePath" Label="Git executable (empty = auto-detect)" Placeholder="C:\Program Files\Git\cmd\git.exe" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </div>
        <p class="gf-dim gf-small">Automatic submodule updates only touch submodules whose recorded commit changed (or that are new), and never overwrite a submodule with local changes. Uninitialized submodules are initialized when a repository opens. Changing the git path takes effect after restart.</p>

        <div class="gf-settings-section">
            <div class="gf-dialog-row"><strong>External tools</strong></div>
            <div class="gf-form-grid">
                <MudTextField T="string" @bind-Value="_s.ExternalDiffTool" Label="Diff tool (git difftool --tool)" Placeholder="empty = git's diff.tool; or bc, meld, kdiff3, vscode…" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField T="string" @bind-Value="_s.ExternalMergeTool" Label="Merge tool (git mergetool --tool)" Placeholder="empty = git's merge.tool; or bc, meld, kdiff3, vscode…" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField T="string" @bind-Value="_s.TerminalCommand" Label="Terminal" Placeholder="empty = Windows Terminal, else Git Bash, else PowerShell" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Error="@(CommandError(_s.TerminalCommand) is not null)" ErrorText="@CommandError(_s.TerminalCommand)" />
                <MudTextField T="string" @bind-Value="_s.EditorCommand" Label="Editor" Placeholder="empty = Visual Studio Code" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Error="@(CommandError(_s.EditorCommand) is not null)" ErrorText="@CommandError(_s.EditorCommand)" />
            </div>
            <p class="gf-dim gf-small">
                Diff and merge tools use your git configuration (difftool.&lt;tool&gt;.path or .cmd), so a tool set up for the command line works here.
                For the terminal and editor, give the program and its arguments; {path} becomes the folder or file (added at the end if missing),
                for example <span class="gf-mono">"C:\Program Files\Notepad++\notepad++.exe" {path}</span>. Use an .exe: a .cmd or .bat would pass file names through cmd.exe.
            </p>
        </div>

        <div class="gf-settings-section">
            <div class="gf-dialog-row">
                <strong>Updates</strong>
                <span class="gf-dim">GitForge @Updates.CurrentVersion</span>
                <span class="gf-spacer"></span>
                <button type="button" class="gf-link-button" @onclick="CheckNowAsync">Check now…</button>
            </div>
            <MudCheckBox T="bool" @bind-Value="_s.CheckForUpdates" Label="Check for updates once a day" Size="Size.Small" Dense="true" Disabled="@(!Updates.CanUpdate)" />
            <MudTextField T="string" @bind-Value="_s.UpdateFeed" Label="Update feed (empty = GitHub releases)" Placeholder="https://updates.example.com/gitforge or \\server\share\gitforge"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(Updates.Policy.Feed is not null || !Updates.CanUpdate)"
                          Error="@(_feedError is not null)" ErrorText="@_feedError" />
            <p class="gf-dim gf-small">
                @if (Updates.UnavailableReason is null && Updates.TryGetFeed(out var currentFeed, out _))
                {
                    <text>Updates come from @currentFeed.Describe(). </text>
                }
                @if (Updates.Policy.IsManaged)
                {
                    <text>Your organization manages @(Updates.Policy.Disabled ? "updates (turned off)" : $"the update feed ({Updates.Policy.Feed})"). </text>
                }
                @if (Updates.UnavailableReason is { } reason)
                {
                    <text>@reason </text>
                }
                The check reads the feed's release list and sends only GitForge's version and platform, nothing about you or your repositories. Updates install only when you choose.
            </p>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Cancel())">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    private sealed class Model
    {
        public ThemePreference Theme { get; set; }
        public string AccentColor { get; set; } = AppSettings.DefaultAccentColor;
        public bool VimNavigation { get; set; }
        public bool FetchOnOpen { get; set; }
        public bool AutoUpdateSubmodules { get; set; }
        public bool SyntaxHighlighting { get; set; }
        public int AutoFetchMinutes { get; set; }
        public string? GitExecutablePath { get; set; }
        public string? ExternalMergeTool { get; set; }
        public string? ExternalDiffTool { get; set; }
        public string? TerminalCommand { get; set; }
        public string? EditorCommand { get; set; }
        public bool CheckForUpdates { get; set; }
        public string? UpdateFeed { get; set; }
    }

    private Model _s = new();
    private string? _feedError;

    protected override void OnInitialized()
    {
        var c = SettingsStore.Current;
        _s = new Model
        {
            Theme = c.Theme, AccentColor = c.AccentColor, VimNavigation = c.VimNavigation, FetchOnOpen = c.FetchOnOpen,
            AutoUpdateSubmodules = c.AutoUpdateSubmodules, SyntaxHighlighting = c.SyntaxHighlighting,
            AutoFetchMinutes = c.AutoFetchMinutes, GitExecutablePath = c.GitExecutablePath, ExternalMergeTool = c.ExternalMergeTool,
            ExternalDiffTool = c.ExternalDiffTool, TerminalCommand = c.TerminalCommand, EditorCommand = c.EditorCommand,
            CheckForUpdates = c.CheckForUpdates, UpdateFeed = c.UpdateFeed,
        };
    }

    /// <summary>A terminal or editor command GitForge can't run safely, or null.</summary>
    private static string? CommandError(string? command) =>
        string.IsNullOrWhiteSpace(command) || ExternalTools.Build(command, "x") is not null ? null : "Use the program's .exe, not a .cmd or .bat file.";

    private async Task OpenShortcutsAsync()
    {
        var dialog = await Dialogs.ShowAsync<ShortcutsDialog>("Keyboard shortcuts", new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true });
        await dialog.Result;
    }

    private async Task CheckNowAsync()
    {
        var dialog = await Dialogs.ShowAsync<UpdateDialog>("Updates", new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true });
        await dialog.Result;
    }

    private async Task Save()
    {
        var m = _s;
        var feed = string.IsNullOrWhiteSpace(m.UpdateFeed) ? null : m.UpdateFeed.Trim();
        _feedError = null;
        if (feed is not null && !UpdateFeed.TryParse(feed, string.Empty, out _, out _feedError)) return;
        if (CommandError(m.TerminalCommand) is not null || CommandError(m.EditorCommand) is not null) return;
        await SettingsStore.UpdateAsync(c => c with
        {
            Theme = m.Theme, AccentColor = m.AccentColor, VimNavigation = m.VimNavigation, FetchOnOpen = m.FetchOnOpen,
            AutoUpdateSubmodules = m.AutoUpdateSubmodules, SyntaxHighlighting = m.SyntaxHighlighting,
            AutoFetchMinutes = Math.Clamp(m.AutoFetchMinutes, 0, 240),
            GitExecutablePath = string.IsNullOrWhiteSpace(m.GitExecutablePath) ? null : m.GitExecutablePath.Trim(),
            ExternalMergeTool = string.IsNullOrWhiteSpace(m.ExternalMergeTool) ? null : m.ExternalMergeTool.Trim(),
            ExternalDiffTool = string.IsNullOrWhiteSpace(m.ExternalDiffTool) ? null : m.ExternalDiffTool.Trim(),
            TerminalCommand = string.IsNullOrWhiteSpace(m.TerminalCommand) ? null : m.TerminalCommand.Trim(),
            EditorCommand = string.IsNullOrWhiteSpace(m.EditorCommand) ? null : m.EditorCommand.Trim(),
            CheckForUpdates = m.CheckForUpdates,
            UpdateFeed = feed,
        });
        Dialog.Close();
    }
}
