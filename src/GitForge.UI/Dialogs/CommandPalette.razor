@inject RepoWorkspace W
@inject ShortcutService Shortcuts
@inject IDialogService Dialogs
@inject IPlatformShell Shell

<MudDialog Class="gf-palette" ContentClass="gf-palette-content">
    <DialogContent>
        <div class="gf-palette-input">
            <MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Small" />
            <input @ref="_input" class="gf-input gf-input-ghost" placeholder="Type a command, branch, or repository…" value="@_query"
                   @oninput="OnInput" @onkeydown="OnKeyDown" aria-label="Command palette search" />
        </div>
        <div class="gf-palette-list" role="listbox">
            @for (var i = 0; i < _matches.Count; i++)
            {
                var index = i;
                var c = _matches[i];
                <div class="gf-palette-item @(index == _active ? "active" : null)" role="option" aria-selected="@(index == _active)"
                     @onclick="@(() => Run(c))" @onmouseenter="@(() => _active = index)">
                    <MudIcon Icon="@c.Icon" Size="Size.Small" Class="gf-dim" />
                    <span class="gf-grow gf-ellipsis">@c.Title</span>
                    <span class="gf-dim gf-small">@c.Group</span>
                    @if (c.Keys is { } keys)
                    {
                        <kbd>@keys</kbd>
                    }
                </div>
            }
            @if (_matches.Count == 0)
            {
                <div class="gf-empty gf-small">No matches</div>
            }
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    /// <summary>Text to start with ("Merge " lists the branches to merge).</summary>
    [Parameter] public string? InitialQuery { get; set; }

    private sealed record PaletteCommand(string Title, string Group, string Icon, string? Keys, Func<Task> Run);

    private ElementReference _input;
    private string _query = string.Empty;
    private List<PaletteCommand> _all = [];
    private List<PaletteCommand> _matches = [];
    private int _active;

    protected override void OnInitialized()
    {
        Func<Task> Cmd(string id) => () => Shortcuts.RaiseAsync(id);
        string? K(string id) => Keymap.Label(W.Settings, id);
        var hasRepo = W.Repo is not null;
        _all =
        [
            new("Open repository…", "Repository", Icons.Material.Outlined.FolderOpen, K("repo.open"), Cmd("repo.open")),
            new("Clone repository…", "Repository", Icons.Material.Outlined.CloudDownload, K("repo.clone"), Cmd("repo.clone")),
            new("Hosting accounts…", "Settings", Icons.Material.Outlined.ManageAccounts, K("accounts.open"), Cmd("accounts.open")),
            new("Settings…", "Settings", Icons.Material.Outlined.Settings, K("settings.open"), Cmd("settings.open")),
            new("Toggle light / dark theme", "Settings", Icons.Material.Outlined.DarkMode, K("theme.toggle"), Cmd("theme.toggle")),
            new("Keyboard shortcuts", "Help", Icons.Material.Outlined.Keyboard, K("help.shortcuts"), Cmd("help.shortcuts")),
            new("Check for updates…", "Help", Icons.Material.Outlined.SystemUpdateAlt, K("app.update"), Cmd("app.update")),
        ];

        if (hasRepo)
        {
            _all.InsertRange(0,
            [
                new("Fetch all remotes", "Remote", Icons.Material.Outlined.Sync, K("remote.fetch"), W.FetchAsync),
                new("Pull (fast-forward if possible)", "Remote", Icons.Material.Outlined.Download, K("remote.pull"), () => W.PullAsync(PullMode.MergeIfNeeded)),
                new("Pull (fast-forward only)", "Remote", Icons.Material.Outlined.Download, null, () => W.PullAsync(PullMode.FastForwardOnly)),
                new("Pull (rebase)", "Remote", Icons.Material.Outlined.Download, null, () => W.PullAsync(PullMode.Rebase)),
                new("Push", "Remote", Icons.Material.Outlined.Upload, K("remote.push"), Cmd("remote.push")),
                new("Push (force with lease)", "Remote", Icons.Material.Outlined.Upload, null, () => W.PushAsync(force: true)),
                new("New branch…", "Branch", Icons.Material.Outlined.CallSplit, K("branch.new"), Cmd("branch.new")),
                new("Clean up branches deleted on the remote…", "Branch", Icons.Material.Outlined.CleaningServices, K("branch.cleanup"), Cmd("branch.cleanup")),
                new("Stash changes…", "Stash", Icons.Material.Outlined.Inventory2, K("stash.save"), Cmd("stash.save")),
                new("Pop latest stash", "Stash", Icons.Material.Outlined.Unarchive, K("stash.pop"), W.PopStashAsync),
                new("Update submodules (recursive)", "Submodules", Icons.Material.Outlined.Extension, null, W.UpdateSubmodulesAsync),
                new("Update submodules to the newest remote commits", "Submodules", Icons.Material.Outlined.Extension, K("submodule.remote"), Cmd("submodule.remote")),
                new("Add submodule…", "Submodules", Icons.Material.Outlined.Extension, K("submodule.add"), Cmd("submodule.add")),
                new("New worktree…", "Worktree", Icons.Material.Outlined.AccountTree, K("worktree.add"), Cmd("worktree.add")),
                new("Show repository in Explorer", "Tools", Icons.Material.Outlined.FolderOpen, K("repo.explorer"), Cmd("repo.explorer")),
                new("Open terminal here", "Tools", Icons.Material.Outlined.Terminal, K("repo.terminal"), Cmd("repo.terminal")),
                new("Open repository in editor", "Tools", Icons.Material.Outlined.Code, K("repo.editor"), Cmd("repo.editor")),
                new("Save uncommitted changes as a patch…", "Patch", Icons.Material.Outlined.Description, K("patch.create"), Cmd("patch.create")),
                new("Apply patch…", "Patch", Icons.Material.Outlined.Description, K("patch.apply"), Cmd("patch.apply")),
                new("Create bundle (offline transfer)…", "Bundle", Icons.Material.Outlined.Inventory, K("bundle.create"), Cmd("bundle.create")),
                new("Fetch from bundle…", "Bundle", Icons.Material.Outlined.Inventory, K("bundle.fetch"), Cmd("bundle.fetch")),
                new("Next repository tab", "Tabs", Icons.Material.Outlined.Tab, K("tab.next"), Cmd("tab.next")),
                new("Close repository tab", "Tabs", Icons.Material.Outlined.Close, K("tab.close"), Cmd("tab.close")),
                new(W.Undo.CanUndo ? $"Undo {W.Undo.UndoDescription}" : "Undo", "Edit", Icons.Material.Outlined.Undo, K("edit.undo"), Cmd("edit.undo")),
                new(W.Undo.CanRedo ? $"Redo {W.Undo.RedoDescription}" : "Redo", "Edit", Icons.Material.Outlined.Redo, K("edit.redo"), Cmd("edit.redo")),
                new("Go to WIP (stage and commit)", "View", Icons.Material.Outlined.EditNote, K("view.status"), Cmd("view.status")),
                new("Go to commit graph", "View", Icons.Material.Outlined.AccountTree, K("view.history"), Cmd("view.history")),
                new("Reflog — recover lost work", "View", Icons.Material.Outlined.Restore, K("view.reflog"), Cmd("view.reflog")),
                new("Changes on current branch (since it branched)", "View", Icons.Material.Outlined.Difference, K("view.changes"), Cmd("view.changes")),
                new("Go to current branch in graph", "View", Icons.Material.Outlined.MyLocation, K("graph.head"), Cmd("graph.head")),
                new("Show all branches in graph", "View", Icons.Material.Outlined.Visibility, null, W.ShowAllRefsAsync),
                new("Toggle git console", "View", Icons.Material.Outlined.Terminal, K("console.toggle"), Cmd("console.toggle")),
                new("Pull requests…", "Remote", Icons.Material.Outlined.MergeType, K("prs.open"), Cmd("prs.open")),
            ]);

            if (W.OpenDiff?.Path is { Length: > 0 } openPath)
            {
                _all.Add(new($"File history: {openPath}", "File", Icons.Material.Outlined.History, null, () => { W.ShowFileHistory(openPath); return Task.CompletedTask; }));
                _all.Add(new($"Blame: {openPath}", "File", Icons.Material.Outlined.PersonSearch, null, () => { W.ShowBlame(openPath, W.OpenDiff?.CommitSha); return Task.CompletedTask; }));
            }

            AddCommitCommands(K, Cmd);

            if (W.IsBisecting)
            {
                _all.InsertRange(0,
                [
                    new("Bisect: mark this commit good", "Bisect", Icons.Material.Outlined.ThumbUp, K("bisect.good"), Cmd("bisect.good")),
                    new("Bisect: mark this commit bad", "Bisect", Icons.Material.Outlined.ThumbDown, K("bisect.bad"), Cmd("bisect.bad")),
                    new("Bisect: skip this commit", "Bisect", Icons.Material.Outlined.SkipNext, K("bisect.skip"), Cmd("bisect.skip")),
                    new("Bisect: end", "Bisect", Icons.Material.Outlined.Close, K("bisect.reset"), Cmd("bisect.reset")),
                ]);
            }
            else if (W.Snapshot?.HeadSha is { } head)
            {
                _all.Add(new("Bisect: start (the checked-out commit has the bug)", "Bisect", Icons.Material.Outlined.ManageSearch, null, () => W.StartBisectAsync(head, BisectMark.Bad)));
            }

            foreach (var wt in W.Worktrees.Where(w => !w.IsCurrent && !w.IsBare))
            {
                _all.Add(new($"Open worktree {wt.Name}{(wt.Branch is { } wb ? $" ({wb})" : null)}", "Worktree", Icons.Material.Outlined.AccountTree, null, () => W.OpenAsync(wt.Path)));
            }

            if (W.Lfs.InUse)
            {
                _all.Add(new("LFS: refresh locks", "LFS", Icons.Material.Outlined.Lock, null, W.RefreshLocksAsync));
            }

            foreach (var other in W.Sessions.Where(s => s != W.Active))
            {
                _all.Add(new($"Switch to {other.Name}", "Tabs", Icons.Material.Outlined.Tab, null, () => W.ActivateAsync(other)));
            }

            foreach (var b in W.Snapshot?.LocalBranches ?? [])
            {
                if (!b.IsCurrent) _all.Add(new($"Checkout {b.Name}", "Branch", Icons.Material.Outlined.Computer, null, () => W.CheckoutAsync(b.Name)));
                if (!b.IsCurrent) _all.Add(new($"Show changes on {b.Name}", "Branch", Icons.Material.Outlined.Difference, null, () => { W.ShowBranchChanges(b.Name); return Task.CompletedTask; }));
                if (!b.IsCurrent && W.CurrentBranch is { } current)
                {
                    _all.Add(new($"Merge {b.Name} into {current}", "Branch", Icons.Material.Outlined.MergeType, null, () => Merge(b.Name)));
                    _all.Add(new($"Rebase {current} onto {b.Name}", "Branch", Icons.Material.Outlined.AltRoute, null, () => Rebase(b.Name)));
                }

                if (!b.IsCurrent && W.WorktreeHolding(b.Name) is null)
                {
                    _all.Add(new($"Check out {b.Name} in a new worktree…", "Worktree", Icons.Material.Outlined.AccountTree, null, () => NewWorktree(b.Name)));
                }
            }

            foreach (var b in W.Snapshot?.RemoteBranches ?? [])
            {
                var local = b.Name[(b.RemoteName!.Length + 1)..];
                if (W.Snapshot!.LocalBranches.Any(l => l.Name == local)) continue;
                _all.Add(new($"Checkout {b.Name} as {local}", "Remote branch", Icons.Material.Outlined.Cloud, null,
                    () => W.RunAsync($"Checking out {local}", (r, _) => r.Branches.CheckoutRemoteBranchAsync(b.Name, local))));
            }

            foreach (var b in W.Snapshot?.RemoteBranches ?? [])
            {
                if (W.CurrentBranch is not { } current) break;
                _all.Add(new($"Merge {b.Name} into {current}", "Remote branch", Icons.Material.Outlined.MergeType, null, () => Merge(b.Name)));
                _all.Add(new($"Rebase {current} onto {b.Name}", "Remote branch", Icons.Material.Outlined.AltRoute, null, () => Rebase(b.Name)));
            }
        }

        foreach (var r in W.Settings.RecentRepositories.Where(r => !string.Equals(r, W.Repo?.WorkingDirectory, StringComparison.OrdinalIgnoreCase)))
        {
            _all.Add(new($"Open {System.IO.Path.GetFileName(r)}", "Recent", Icons.Material.Outlined.Folder, null, () => W.OpenAsync(r)));
        }

        _query = InitialQuery ?? string.Empty;
        Filter();
    }

    /// <summary>Actions on the commit selected in the graph (the palette's version of its right-click menu).</summary>
    private void AddCommitCommands(Func<string, string?> K, Func<string, Func<Task>> Cmd)
    {
        if (W.WipSelected || W.SelectedCommitSha is not { } sha || W.FindCommit(sha) is not { } c) return;
        var at = $"{c.ShortSha} “{(c.Subject.Length > 40 ? c.Subject[..40] + "…" : c.Subject)}”";
        var target = W.CurrentBranch ?? "HEAD";
        _all.AddRange(
        [
            new($"Cherry-pick {at} onto {target}", "Commit", Icons.Material.Outlined.ContentPasteGo, K("commit.cherrypick"), Cmd("commit.cherrypick")),
            new($"Revert {at}…", "Commit", Icons.Material.Outlined.Undo, K("commit.revert"), Cmd("commit.revert")),
            new($"New branch at {at}…", "Commit", Icons.Material.Outlined.CallSplit, null, () => CommitActions.NewBranchAsync(W, Dialogs, c)),
            new($"New tag at {at}…", "Commit", Icons.Material.Outlined.LocalOffer, K("commit.tag"), Cmd("commit.tag")),
            new($"Reset {target} to {at} (soft: keep index)", "Commit", Icons.Material.Outlined.Restore, null, () => CommitActions.ResetAsync(W, Dialogs, c, ResetMode.Soft)),
            new($"Reset {target} to {at} (mixed: keep files)", "Commit", Icons.Material.Outlined.Restore, null, () => CommitActions.ResetAsync(W, Dialogs, c, ResetMode.Mixed)),
            new($"Reset {target} to {at} (hard: discard changes)…", "Commit", Icons.Material.Outlined.Restore, null, () => CommitActions.ResetAsync(W, Dialogs, c, ResetMode.Hard)),
            new($"Interactive rebase of the commits after {at}…", "Commit", Icons.Material.Outlined.Reorder, null, () => CommitActions.InteractiveRebaseAsync(W, Dialogs, c)),
            new($"Save {at} as a patch…", "Commit", Icons.Material.Outlined.Description, K("commit.patch"), Cmd("commit.patch")),
            new($"Compare {at} with the working tree", "Commit", Icons.Material.Outlined.Difference, null, () => { W.ShowCompare(c.Sha, null); return Task.CompletedTask; }),
            new($"Bisect: {at} {(W.IsBisecting ? "is good" : "works (start)")}", "Bisect", Icons.Material.Outlined.ThumbUp, null, () => CommitActions.BisectAsync(W, c, BisectMark.Good)),
            new($"Bisect: {at} {(W.IsBisecting ? "is bad" : "has the bug (start)")}", "Bisect", Icons.Material.Outlined.ThumbDown, null, () => CommitActions.BisectAsync(W, c, BisectMark.Bad)),
        ]);
    }

    private async Task Merge(string branch)
    {
        if (await Dialogs.ShowMessageBoxAsync("Merge", $"Merge {branch} into {W.CurrentBranch}?", yesText: "Merge", cancelText: "Cancel") == true)
        {
            await W.RunAsync($"Merging {branch}", (r, _) => r.History.MergeAsync(branch, false), $"Merged {branch} into {W.CurrentBranch}");
        }
    }

    private async Task Rebase(string onto)
    {
        if (await Dialogs.ShowMessageBoxAsync("Rebase", $"Rebase {W.CurrentBranch} onto {onto}? Local commits will be rewritten.", yesText: "Rebase", cancelText: "Cancel") == true)
        {
            await W.RunAsync($"Rebasing onto {onto}", (r, _) => r.History.RebaseOntoAsync(onto), $"Rebased {W.CurrentBranch} onto {onto}");
        }
    }

    private async Task NewWorktree(string branch)
    {
        var parameters = new DialogParameters<WorktreeDialog> { { d => d.Branch, branch } };
        var dialog = await Dialogs.ShowAsync<WorktreeDialog>("New worktree", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true });
        await dialog.Result;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await _input.FocusAsync();
    }

    private void OnInput(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? string.Empty;
        Filter();
    }

    /// <summary>Subsequence fuzzy match: contiguous and word-start hits score higher.</summary>
    private void Filter()
    {
        var q = _query.Trim();
        _matches = q.Length == 0
            ? _all.Take(50).ToList()
            : _all.Select(c => (c, score: Score(c.Title + " " + c.Group, q)))
                  .Where(x => x.score > 0)
                  .OrderByDescending(x => x.score)
                  .Take(50)
                  .Select(x => x.c)
                  .ToList();
        _active = 0;
    }

    internal static int Score(string text, string query)
    {
        var t = text.ToLowerInvariant();
        var q = query.ToLowerInvariant();
        if (t.Contains(q, StringComparison.Ordinal)) return 1000 - t.IndexOf(q, StringComparison.Ordinal);
        var score = 0;
        var ti = 0;
        foreach (var ch in q)
        {
            if (ch == ' ') continue;
            var found = t.IndexOf(ch, ti);
            if (found < 0) return 0;
            score += found == ti ? 5 : (found > 0 && t[found - 1] is ' ' or '/' or '-' ? 4 : 1);
            ti = found + 1;
        }

        return score;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown": _active = Math.Min(_active + 1, Math.Max(_matches.Count - 1, 0)); break;
            case "ArrowUp": _active = Math.Max(_active - 1, 0); break;
            case "Enter" when _matches.Count > 0: await Run(_matches[_active]); break;
            case "Escape": Dialog.Cancel(); break;
        }
    }

    private async Task Run(PaletteCommand c)
    {
        Dialog.Close();
        await c.Run();
    }
}
